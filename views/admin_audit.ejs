<style>
/* AUDIT_COMPACT_SEARCH_BLOCK_START */
body.page-audit .audit-filter-card{
  padding:10px !important;
  border-radius:16px !important;
  max-width:1180px !important;
  margin:0 auto 16px !important;
}

body.page-audit .audit-filter-grid{
  display:grid !important;
  grid-template-columns:repeat(4, minmax(0, 1fr)) !important;
  gap:8px !important;
  align-items:end !important;
}

body.page-audit .audit-filter-field{
  min-width:0 !important;
  width:100% !important;
}

body.page-audit .audit-filter-field label{
  display:block !important;
  margin:0 0 3px !important;
  font-size:11px !important;
  line-height:1.1 !important;
  color:var(--muted) !important;
}

body.page-audit .audit-filter-field input,
body.page-audit .audit-filter-field .form-control{
  width:100% !important;
  min-width:0 !important;
  max-width:100% !important;
  height:30px !important;
  min-height:30px !important;
  padding:4px 10px !important;
  border-radius:9px !important;
