  padding:16px;
  border-radius:12px;
  background:var(--card);
  border:1px solid var(--border);
  box-shadow:var(--shadow-card);
}

.center-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:12px;
}

.center-head strong{
