      <div class="lf-field">
        <label class="form-label">Р РµР¶РёРј</label>
        <select class="form-select" name="status" data-filter="status">
          <option value="">Р’СЃРµ СЃРѕР±С‹С‚РёСЏ</option>
          <option value="ok" <%= (filters && filters.status === 'ok') ? 'selected' : '' %>>РўРѕР»СЊРєРѕ СѓСЃРїРµС€РЅС‹Рµ</option>
          <option value="attention" <%= (filters && filters.status === 'attention') ? 'selected' : '' %>>РўСЂРµР±СѓСЋС‚ РІРЅРёРјР°РЅРёСЏ</option>
        </select>
      </div>

      <div class="lf-field">
