</div>

<div class="card card-glass p-0 overflow-hidden">
  <div class="table-responsive logs-table-wrap">
    <table class="table table-dark table-hover align-middle m-0">
      <thead>
        <tr>
          <th class="text-mono">Р”Р°С‚Р°</th>
          <th class="text-mono">Р’СЂРµРјСЏ</th>
          <th>Р§С‚Рѕ РѕС‚РєСЂС‹РІР°Р»Рё</th>
          <th>Р”РµР№СЃС‚РІРёРµ</th>
          <th>РљС‚Рѕ</th>
          <th class="d-none d-xl-table-cell">РўРµР»РµС„РѕРЅ</th>
          <th class="d-none d-xl-table-cell">РСЃС‚РѕС‡РЅРёРє</th>
          <th class="d-none d-md-table-cell">Р РµР·СѓР»СЊС‚Р°С‚</th>
          <th class="d-none d-lg-table-cell">РљРѕРјР°РЅРґР°</th>
          <th class="d-none d-md-table-cell">РЎРµСЃСЃРёСЏ</th>
        </tr>
      </thead>
      <tbody>
<% if (logs && logs.length) { %>
