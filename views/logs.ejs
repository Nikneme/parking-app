<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<% const pageTitle = (typeof title !== "undefined" && title) ? title : "Р–СѓСЂРЅР°Р» РїСЂРѕС…РѕРґРѕРІ Рё РїСЂРѕРµР·РґРѕРІ"; %>
<%- include('partials/header', { title: pageTitle, bodyClass, user, path: '/logs' }) %>

<%
  const __summary = (typeof logSummary !== 'undefined' && logSummary) ? logSummary : {};
  const __quickLinks = (typeof quickLinks !== 'undefined' && quickLinks) ? quickLinks : {};
  const __todayMsk = (() => {
    try {
      const parts = new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Europe/Moscow',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).formatToParts(new Date());
      const get = (type) => parts.find((item) => item.type === type)?.value || '';
      return `${get('year')}-${get('month')}-${get('day')}`;
    } catch (e) {
      return '';
    }
  })();
  const EVENT_LABELS = {
    open: 'РћС‚РєСЂС‹С‚РёРµ',
    close: 'Р—Р°РєСЂС‹С‚РёРµ',
    unlock: 'РћС‚РєСЂС‹С‚РёРµ',
    lock: 'Р—Р°РєСЂС‹С‚РёРµ',
    error: 'РћС€РёР±РєР°',
  };
  const eventLabel = (ev) => {
    const k = String(ev || '').trim();
    return EVENT_LABELS[k] || k;
  };

  const RESULT_LABELS = {
    ok: 'РЈСЃРїРµС€РЅРѕ',
    denied: 'РќРµС‚ РґРѕСЃС‚СѓРїР°',
    disabled: 'РћС‚РєР»СЋС‡РµРЅРѕ',
  };
  const resultLabel = (value) => {
    const raw = String(value || '').trim();
    if (!raw) return 'вЂ”';
    if (raw.startsWith('gw_error:')) return 'РћС€РёР±РєР° С€Р»СЋР·Р°';
    return RESULT_LABELS[raw] || raw;
  };
  const resultTone = (value) => {
    const raw = String(value || '').trim().toLowerCase();
    if (!raw) return 'is-neutral';
    return raw === 'ok' ? 'is-ok' : 'is-attention';
  };

  const quickActive = {
    all: !(filters && (filters.status || filters.result || filters.date_from || filters.date_to || filters.request_id || filters.point || filters.event || filters.fio || filters.organization || filters.position)),
    ok: filters && filters.status === 'ok' && !filters.result,
    attention: filters && filters.status === 'attention' && !filters.result,
    today: filters && filters.date_from === __todayMsk && filters.date_to === __todayMsk,
  };
  const __activeFilterCount = [
    'date_from',
    'date_to',
    'time_from',
    'time_to',
    'status',
    'point',
    'event',
    'result',
    'request_id',
    'fio',
    'organization',
    'position'
  ].filter((key) => filters && filters[key]).length;
  const formatTs = (v) => {
    if (!v) return '';
    const d = (v instanceof Date) ? v : new Date(v);
    if (Number.isNaN(d.getTime())) return String(v);
    try {
      return new Intl.DateTimeFormat('ru-RU', {
        timeZone: 'Europe/Moscow',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hourCycle: 'h23',
      }).format(d).replace(',', '');
    } catch (e) {
      return String(v);
    }
  };
%>
<style>
