<%- include('partials/header', { title: 'Смена пароля', bodyClass: 'page-login', user: user || null, path: '/change-password' }) %>

<div class="card" style="max-width:560px; margin: 12px auto 0;">
  <h1 style="margin:0 0 4px;">Смена временного пароля</h1>
  <div class="muted" style="margin-bottom:12px;">
    <% if (reason === 'expired') { %>
      Срок действия стартового пароля истёк. Чтобы продолжить работу, задайте новый постоянный пароль.
    <% } else { %>
      Перед началом работы необходимо заменить стартовый пароль на постоянный.
    <% } %>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert err"><%= error %></div>
  <% } %>

  <form method="post" action="/change-password">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="row">
      <div class="field">
        <label>Новый пароль</label>
        <input name="new_pin" type="password" autocomplete="new-password" autocapitalize="none" spellcheck="false" required minlength="<%= pinMinLength %>" />
        <div class="hint">Минимум <%= pinMinLength %> символов. Не используйте временный пароль или номер телефона.</div>
      </div>
      <div class="field">
        <label>Повторите пароль</label>
        <input name="new_pin_confirm" type="password" autocomplete="new-password" autocapitalize="none" spellcheck="false" required minlength="<%= pinMinLength %>" />
      </div>
    </div>

    <div style="margin-top:12px; display:flex; gap:8px; align-items:center;">
      <button class="btn btn-primary" style="flex:1;">Сохранить пароль</button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
