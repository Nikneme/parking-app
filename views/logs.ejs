<script>
document.addEventListener('DOMContentLoaded', function () {
  function move(parent, node) {
    if (!parent || !node) return;
    if (node.parentNode !== parent) parent.appendChild(node);
  }

  function makeField(input, labelText, cls) {
    if (!input) return null;
    const wrap = document.createElement('div');
    wrap.className = 'filters-rows-field ' + cls;

    const label = document.createElement('label');
    label.textContent = labelText;

    wrap.appendChild(label);
    wrap.appendChild(input);
    return wrap;
  }

  function createInput(name, placeholder) {
    const el = document.createElement('input');
    el.type = 'text';
    el.name = name;
    el.placeholder = placeholder;
    el.className = 'form-control';
    el.value = new URLSearchParams(window.location.search).get(name) || '';
    return el;
  }

  function findCsv(form, csvPath) {
    return (
      form.querySelector('a[href*="' + csvPath + '"]') ||
      form.parentElement?.querySelector('a[href*="' + csvPath + '"]') ||
      document.querySelector('a[href*="' + csvPath + '"]')
    );
  }

  function rebuild(form, csvPath) {
    if (!form || form.dataset.filtersRowsReady === '1') return;

    const hidden = Array.from(form.querySelectorAll('input[type="hidden"]'));
    const dateFrom = form.querySelector('[name="date_from"]');
    const dateTo = form.querySelector('[name="date_to"]');
    const timeFrom = form.querySelector('[name="time_from"]');
    const timeTo = form.querySelector('[name="time_to"]');
    const status = form.querySelector('[name="status"]');
    const point = form.querySelector('[name="point"]');
    const event = form.querySelector('[name="event"]');
    const result = form.querySelector('[name="result"]');
    const requestId = form.querySelector('[name="request_id"]') || createInput('request_id', 'РќР°РїСЂРёРјРµСЂ 2ce52abe');
    const org = form.querySelector('[name="organization"]') || createInput('organization', 'РџРѕРёСЃРє РїРѕ РѕСЂРіР°РЅРёР·Р°С†РёРё');
    const fio = form.querySelector('[name="fio"]') || createInput('fio', 'РџРѕРёСЃРє РїРѕ Р¤РРћ');
    const pos = form.querySelector('[name="position"]') || createInput('position', 'РџРѕРёСЃРє РїРѕ РґРѕР»Р¶РЅРѕСЃС‚Рё');

    const submitBtn =
      form.querySelector('button[type="submit"]') ||
      form.querySelector('.btn.btn-primary') ||
      form.querySelector('button');

    const csvLink = findCsv(form, csvPath);

    const grid = document.createElement('div');
    grid.className = 'filters-rows-grid';

    hidden.forEach(function (h) { move(grid, h); });

    [
      makeField(dateFrom, 'Р”Р°С‚Р° СЃ', 'fr-col-3'),
      makeField(dateTo, 'Р”Р°С‚Р° РїРѕ', 'fr-col-3'),
      makeField(timeFrom, 'Р’СЂРµРјСЏ СЃ', 'fr-col-2'),
      makeField(timeTo, 'Р’СЂРµРјСЏ РїРѕ', 'fr-col-2'),
      makeField(status, 'Р РµР¶РёРј', 'fr-col-2'),
      makeField(point, 'Р§С‚Рѕ РѕС‚РєСЂС‹РІР°Р»Рё', 'fr-col-4'),
      makeField(event, 'РЎРѕР±С‹С‚РёРµ', 'fr-col-4'),
      makeField(result, 'Р РµР·СѓР»СЊС‚Р°С‚', 'fr-col-4'),
      makeField(requestId, 'РљРѕРјР°РЅРґР°', 'fr-col-4'),
      makeField(fio, 'Р¤РРћ', 'fr-col-4'),
      makeField(org, 'РћСЂРіР°РЅРёР·Р°С†РёСЏ', 'fr-col-4'),
      makeField(pos, 'Р”РѕР»Р¶РЅРѕСЃС‚СЊ', 'fr-col-4'),
    ].forEach(function (field) {
      if (field) grid.appendChild(field);
    });

    const actions = document.createElement('div');
    actions.className = 'filters-rows-actions';

    if (submitBtn) {
      submitBtn.classList.add('btn');
      move(actions, submitBtn);
    }
    if (csvLink) {
      csvLink.classList.add('btn');
      move(actions, csvLink);
    }

    grid.appendChild(actions);
    form.replaceChildren(grid);
    form.classList.add('filters-rows-form');
    form.dataset.filtersRowsReady = '1';

    function syncCsv() {
      if (!csvLink) return;
      const url = new URL(csvPath, window.location.origin);
      const fd = new FormData(form);

      fd.forEach(function (value, key) {
        const v = String(value || '').trim();
        if (v) url.searchParams.set(key, v);
      });

      csvLink.setAttribute('href', url.pathname + url.search);
    }

    form.addEventListener('input', syncCsv);
    form.addEventListener('change', syncCsv);
    syncCsv();
  }

  rebuild(
    document.querySelector('form[action="/logs"]') || document.querySelector('form[action*="/logs"]'),
    '/logs.csv'
  );

  rebuild(
    document.querySelector('form[action="/admin/audit"]') || document.querySelector('form[action*="/admin/audit"]'),
    '/admin/audit.csv'
  );
});
</script>
