<script>
document.addEventListener('DOMContentLoaded', function () {
  if (window.innerWidth > 760) return;

  const form =
    document.querySelector('form[action="/admin/audit"]') ||
    document.querySelector('form[action*="/admin/audit"]');

  if (!form) return;
  if (form.dataset.auditNativeWrapReady === '1') return;

  function prettyDate(v) {
    if (!v) return 'Р’С‹Р±РµСЂРёС‚Рµ РґР°С‚Сѓ';
    return v;
  }

  function prettyTime(v) {
    if (!v) return 'Р’С‹Р±РµСЂРёС‚Рµ РІСЂРµРјСЏ';
    return v;
  }

  function wrapInput(name, emptyText, formatter) {
    const input = form.querySelector('input[name="' + name + '"]');
    if (!input) return;
    if (input.closest('.audit-picker-wrap')) return;

    const wrap = document.createElement('div');
    wrap.className = 'audit-picker-wrap';

    const visual = document.createElement('div');
    visual.className = 'audit-picker-visual';

    function sync() {
      const text = formatter(input.value || '');
      visual.textContent = text || emptyText;
      visual.classList.toggle('is-empty', !input.value);
    }

    input.classList.add('audit-picker-native');
    input.parentNode.insertBefore(wrap, input);
    wrap.appendChild(visual);
    wrap.appendChild(input);

    input.addEventListener('input', sync);
    input.addEventListener('change', sync);
    sync();
  }

  wrapInput('date_from', 'Р’С‹Р±РµСЂРёС‚Рµ РґР°С‚Сѓ', prettyDate);
  wrapInput('date_to', 'Р’С‹Р±РµСЂРёС‚Рµ РґР°С‚Сѓ', prettyDate);
  wrapInput('time_from', 'Р’С‹Р±РµСЂРёС‚Рµ РІСЂРµРјСЏ', prettyTime);
  wrapInput('time_to', 'Р’С‹Р±РµСЂРёС‚Рµ РІСЂРµРјСЏ', prettyTime);

  form.dataset.auditNativeWrapReady = '1';
});
</script>
