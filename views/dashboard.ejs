  function normalizeSearch(value) {
    return String(value || '')
      .toLowerCase()
      .replace(/ё/g, 'е')
      .replace(/[\u2013\u2014]/g, '-')
      .replace(/[^a-zа-я0-9/#+\-.\s]/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function isLikelyFloor(value) {
    const num = Number(value);
    return Number.isInteger(num) && num >= 1 && num <= 11;
  }

  const SEARCH_ALIAS_GROUPS = [
    {
      label: '-1 этаж',
      terms: ['-1', 'минус 1', 'минус первый', 'п1', 'подземный 1', 'подземный -1'],
      matchRelated: ['-1 этаж', 'Въезд П1'],
      related: ['-1 этаж', 'Подземный уровень', 'Въезд П1']
    },
    {
      label: '-2 этаж',
      terms: ['-2', 'минус 2', 'минус второй', 'п2', 'п2/3', 'подземный 2', 'подземный -2'],
      matchRelated: ['-2 этаж', 'Въезд П2/3'],
      related: ['-2 этаж', 'Подземный уровень', 'Въезд П2/3']
    },
    {
      label: 'Подземный уровень',
      terms: ['подземный', 'подземный уровень', 'подземка', 'под землей', 'подземный въезд', 'подземная часть'],
      matchRelated: ['Подземный уровень', 'Въезд П1', 'Въезд П2/3'],
      related: ['Подземный уровень', 'Въезд П1', 'Въезд П2/3']
    }
  ];

  function compactSearch(value) {
    return normalizeSearch(value).replace(/\s+/g, '');
  }

  function levenshteinDistance(a, b, maxDistance) {
    const left = String(a || '');
    const right = String(b || '');
    const limit = Number.isFinite(maxDistance) ? maxDistance : Math.max(left.length, right.length);
    if (Math.abs(left.length - right.length) > limit) return limit + 1;
    const prev = Array.from({ length: right.length + 1 }, (_, idx) => idx);

    for (let i = 1; i <= left.length; i += 1) {
      let current = [i];
      let rowMin = current[0];
      for (let j = 1; j <= right.length; j += 1) {
        const cost = left[i - 1] === right[j - 1] ? 0 : 1;
        const next = Math.min(
          prev[j] + 1,
          current[j - 1] + 1,
          prev[j - 1] + cost
        );
        current[j] = next;
        if (next < rowMin) rowMin = next;
      }
      if (rowMin > limit) return limit + 1;
      for (let j = 0; j < current.length; j += 1) prev[j] = current[j];
    }

    return prev[right.length];
  }

  function looksClose(query, term) {
    const q = normalizeSearch(query);
    const t = normalizeSearch(term);
    if (!q || !t) return false;
    if (q === t) return true;

    const qCompact = compactSearch(q);
    const tCompact = compactSearch(t);

    if (q.length >= 3 && (t.includes(q) || q.includes(t))) return true;
    if (qCompact && tCompact && qCompact === tCompact) return true;
    if (q.length >= 4 && (tCompact.includes(qCompact) || qCompact.includes(tCompact))) return true;

    const limit = q.length >= 8 ? 2 : 1;
    return levenshteinDistance(qCompact, tCompact, limit) <= limit;
  }

  function aliasIntentScore(query, group) {
    const q = normalizeSearch(query);
    const qCompact = compactSearch(q);
    if (!q || !group) return Number.POSITIVE_INFINITY;

    let best = Number.POSITIVE_INFINITY;
    [group.label].concat(group.terms || [], group.related || []).forEach((term) => {
      const normalized = normalizeSearch(term);
      const normalizedCompact = compactSearch(normalized);
      if (!normalized || !normalizedCompact) return;

      if (normalized === q || normalizedCompact === qCompact) {
        best = Math.min(best, 0);
        return;
      }
      if (normalized.startsWith(q) || normalizedCompact.startsWith(qCompact)) {
        best = Math.min(best, 1);
        return;
      }
      if (q.length >= 3 && (normalized.includes(q) || normalizedCompact.includes(qCompact))) {
        best = Math.min(best, 2);
        return;
      }

      const limit = q.length >= 8 ? 2 : 1;
      const distance = levenshteinDistance(qCompact, normalizedCompact, limit);
      if (distance <= limit) {
        best = Math.min(best, 3 + distance);
      }
    });

    return best;
  }

  function floorIntent(value) {
    const normalized = normalizeSearch(value);
    const positive = normalized.match(/^(\d{1,2})(?:\s*(?:эт|этаж|этажа))?$/);
    if (positive && isLikelyFloor(positive[1])) {
      const floor = positive[1];
      return {
        label: floor + ' этаж',
        related: [floor + ' этаж', 'Въезд ' + floor + 'эт', 'Выезд ' + floor + 'эт']
      };
    }
    return null;
  }

  function findAliasIntent(value) {
    const normalized = normalizeSearch(value);
    if (!normalized) return null;
    let winner = null;
    let bestScore = Number.POSITIVE_INFINITY;
    SEARCH_ALIAS_GROUPS.forEach((group) => {
      const score = aliasIntentScore(normalized, group);
      if (score < bestScore) {
        bestScore = score;
        winner = group;
      }
    });
    if (!winner || !Number.isFinite(bestScore)) return null;
    return {
      label: winner.label,
      matchRelated: Array.isArray(winner.matchRelated) ? winner.matchRelated.slice() : winner.related.slice(),
      related: winner.related.slice()
    };
  }

  function interpretSearchIntent(value) {
    return floorIntent(value) || findAliasIntent(value);
  }

  function isExactLocationIntent(value) {
    const normalized = normalizeSearch(value);
    if (!normalized) return false;
    if (floorIntent(normalized)) return true;
    const alias = findAliasIntent(normalized);
    return !!(alias && /^-\d+\s*этаж$/u.test(String(alias.label || '')));
  }

  function buildSearchVariants(value) {
    const normalized = normalizeSearch(value);
    if (!normalized) return [];

    const variants = new Set();
    const floorOnly = normalized.match(/^(\d{1,2})(?:\s*(?:эт|этаж|этажа))?$/);

    function addVariant(next) {
      const clean = normalizeSearch(next);
      if (!clean) return;
      variants.add(clean);
      if (clean.includes(' ')) variants.add(clean.replace(/\s+/g, ''));
    }

    if (!floorOnly) {
      addVariant(normalized);
      addVariant(normalized.replace(/\s+/g, ''));
    }

    if (floorOnly && isLikelyFloor(floorOnly[1])) {
      const floor = floorOnly[1];
      addVariant(floor + ' этаж');
      addVariant('этаж ' + floor);
      addVariant(floor + ' эт');
      addVariant(floor + 'эт');
    }

    Array.from(normalized.matchAll(/\b(\d{1,2})\s*(эт|этаж|этажа)\b/g)).forEach((match) => {
      if (!isLikelyFloor(match[1])) return;
      addVariant(match[1]);
      addVariant(match[1] + ' этаж');
      addVariant('этаж ' + match[1]);
      addVariant(match[1] + ' эт');
      addVariant(match[1] + 'эт');
    });

    Array.from(normalized.matchAll(/\b([a-zа-я]+)\s*(\d[\d/-]*)\b/gi)).forEach((match) => {
      addVariant(match[1] + match[2]);
      addVariant(match[1] + ' ' + match[2]);
    });

    const intent = interpretSearchIntent(normalized);
    if (intent && Array.isArray(intent.matchRelated || intent.related)) {
      (intent.matchRelated || intent.related).forEach(addVariant);
    }

    return Array.from(variants);
  }

  function buildSearchIndex(value) {
    return buildSearchVariants(value).join(' ');
  }

  function matchesSearch(query, haystack) {
    const variants = buildSearchVariants(query);
    if (!variants.length) return true;
    const index = buildSearchIndex(haystack);
    return variants.some((variant) => index.includes(variant));
  }

  function collectSearchCandidates() {
    const map = new Map();

    function pushCandidate(label, search, extraTerms) {
      const nextLabel = String(label || '').trim();
      const nextSearch = String(search || nextLabel).trim();
      if (!nextLabel || !nextSearch) return;
      const key = normalizeSearch(nextSearch);
      if (!key) return;
      if (!map.has(key)) {
        map.set(key, {
          label: nextLabel,
          search: nextSearch,
          terms: []
        });
      }
      const item = map.get(key);
      [nextLabel, nextSearch].concat(extraTerms || []).forEach((term) => {
        const normalized = normalizeSearch(term);
        if (!normalized) return;
        if (!item.terms.includes(normalized)) item.terms.push(normalized);
      });
    }

    SEARCH_ALIAS_GROUPS.forEach((group) => {
      pushCandidate(group.label, group.label, group.terms.concat(group.related || []));
    });

    document.querySelectorAll('[data-open-device]').forEach((btn) => {
      pushCandidate(btn.getAttribute('data-device-name') || btn.textContent || '', btn.getAttribute('data-device-name') || btn.textContent || '');
    });

    document.querySelectorAll('[data-route-section]').forEach((section) => {
      const title = section.querySelector('.route-section-title')?.textContent || '';
      const subtitle = section.querySelector('.route-section-sub')?.textContent || '';
      pushCandidate(title, title, [subtitle]);
    });

    document.querySelectorAll('[data-zone-card]').forEach((card) => {
      const name = card.getAttribute('data-zone-name') || '';
      const sub = card.querySelector('.zone-sub')?.textContent || '';
      pushCandidate(name, name, [sub]);
    });

    return Array.from(map.values());
  }

  const SEARCH_CANDIDATES = collectSearchCandidates();

  function findSearchSuggestions(query, limit) {
    const q = normalizeSearch(query);
    const qCompact = compactSearch(q);
    if (!q) return [];

    const scored = SEARCH_CANDIDATES.map((candidate) => {
      let best = Number.POSITIVE_INFINITY;
      candidate.terms.forEach((term) => {
        const termCompact = compactSearch(term);
        if (term === q || termCompact === qCompact) {
          best = Math.min(best, 0);
          return;
        }
        if (q.length >= 3 && (term.startsWith(q) || term.includes(q) || termCompact.includes(qCompact))) {
          best = Math.min(best, 1);
          return;
        }
        const distance = levenshteinDistance(qCompact, termCompact, 2);
        if (distance <= 2) {
          best = Math.min(best, 2 + distance);
        }
      });
      return { candidate, score: best };
    })
      .filter((item) => Number.isFinite(item.score))
      .sort((a, b) => a.score - b.score || a.candidate.label.localeCompare(b.candidate.label, 'ru', { sensitivity: 'base' }));

    return scored.slice(0, limit || 4).map((item) => item.candidate);
  }

  function renderSearchHelp(query, visibleDevices) {
    if (!searchHelp || !searchHelpTitle || !searchHelpChips) return;
    const normalized = normalizeSearch(query);
    if (!normalized) {
      searchHelp.classList.remove('show');
      searchHelpTitle.textContent = '';
      searchHelpChips.innerHTML = '';
      return;
    }

    const intent = interpretSearchIntent(normalized);
    const suggestions = findSearchSuggestions(normalized, 4);
    const chips = [];
    let title = '';

    if (visibleDevices === 0 && intent) {
      title = 'Похоже, вы ищете: ' + intent.label + '. Для текущего доступа подходящих вариантов не найдено.';
      intent.related.forEach((label) => chips.push({ label, query: label }));
    } else if (visibleDevices === 0 && suggestions.length) {
      title = 'Не нашли точное совпадение. Попробуйте один из вариантов ниже.';
      suggestions.forEach((item) => chips.push({ label: item.label, query: item.search }));
    } else if (intent && !floorIntent(normalized)) {
      title = 'Ищем как: ' + intent.label + '.';
      intent.related.forEach((label) => chips.push({ label, query: label }));
    }

    const unique = [];
    const seen = new Set();
    chips.forEach((item) => {
      const key = normalizeSearch(item.query || item.label);
      if (!key || seen.has(key)) return;
      seen.add(key);
      unique.push(item);
    });

    if (!title || !unique.length) {
      searchHelp.classList.remove('show');
      searchHelpTitle.textContent = '';
      searchHelpChips.innerHTML = '';
      return;
    }

    searchHelpTitle.textContent = title;
    searchHelpChips.innerHTML = unique.slice(0, 4).map((item) => {
      return '<button type="button" class="search-help-chip" data-apply-query="' + escapeHtml(item.query) + '">' + escapeHtml(item.label) + '</button>';
    }).join('');
    searchHelp.classList.add('show');
    bindQueryButtons(searchHelp);
  }

  function applySearch() {
    const query = normalizeSearch(searchInput?.value || '');
    const searching = !!query;
    const exactLocationIntent = isExactLocationIntent(query);
    const cards = Array.from(document.querySelectorAll('[data-zone-card]'));
    const quickRoutes = Array.from(document.querySelectorAll('[data-jump-section]'));
    let visibleDevices = 0;

    if (dashboardPage) dashboardPage.classList.toggle('is-searching', searching);

    cards.forEach((card) => {
      const zoneName = card.dataset.zoneSearchIndex || buildSearchIndex(card.getAttribute('data-zone-name') || '');
      card.dataset.zoneSearchIndex = zoneName;
      const buttons = Array.from(card.querySelectorAll('[data-open-device]'));
      const sections = Array.from(card.querySelectorAll('[data-route-section]'));
      let visibleInZone = 0;

      buttons.forEach((btn) => {
        const text = btn.dataset.searchIndex || buildSearchIndex(btn.getAttribute('data-device-search') || btn.textContent || '');
        btn.dataset.searchIndex = text;
        const visible = !query || matchesSearch(query, text) || (!exactLocationIntent && matchesSearch(query, zoneName));
        btn.classList.toggle('is-hidden', !visible);
        if (visible) {
          visibleInZone += 1;
          visibleDevices += 1;
        }
      });

      sections.forEach((section) => {
        const sectionButtons = Array.from(section.querySelectorAll('[data-open-device]'));
        const sectionText = section.dataset.searchIndex || buildSearchIndex(section.getAttribute('data-route-local-search') || section.getAttribute('data-route-search') || '');
        section.dataset.searchIndex = sectionText;
        const visible = sectionButtons.some((btn) => !btn.classList.contains('is-hidden'))
          || (!!query && matchesSearch(query, sectionText))
          || (!!query && !exactLocationIntent && matchesSearch(query, zoneName));
        section.classList.toggle('is-hidden', query && !visible);
      });

      card.classList.toggle('is-hidden', searching && visibleInZone === 0);
      if (searching && visibleInZone > 0) card.classList.add('open');
    });

    quickRoutes.forEach((btn) => {
      const text = btn.dataset.searchIndex || buildSearchIndex(btn.getAttribute('data-route-search') || btn.textContent || '');
      btn.dataset.searchIndex = text;
      const visible = !searching || matchesSearch(query, text);
      btn.classList.toggle('is-hidden', !visible);
    });
    if (tenantQuickRoutes) tenantQuickRoutes.style.display = quickRoutes.some((btn) => !btn.classList.contains('is-hidden')) ? '' : 'none';

    if (searchCount) {
      const text = searching ? ('Найдено: ' + visibleDevices) : (searchCountPrefix ? (searchCountPrefix + visibleDevices) : '');
      searchCount.textContent = text;
      searchCount.hidden = !text;
    }
    if (noMatches) noMatches.style.display = searching && visibleDevices === 0 ? 'block' : 'none';
    renderSearchHelp(query, visibleDevices);
  }

  function pluralRu(n, one, few, many) {
    const mod10 = n % 10;
    const mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return one;
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return few;
    return many;
  }

  async function refreshDashboardLive() {
    try {
      const res = await fetch('/api/dashboard/live', {
        headers: { 'Accept': 'application/json' },
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.ok) return;

      renderGatewayStatus(data.gateway || {});
      renderZonePulse(data.zones || []);
      renderLiveFeed(data.recentEvents || []);
      renderTimeline(data.timeline || []);
      renderAttention(data.attentionEvents || []);
      renderSignalSummary(data.stats || {}, data.recentEvents || []);
      if (liveGeneratedAt) {
        const dt = data.generatedAt ? new Date(data.generatedAt) : null;
        liveGeneratedAt.textContent = dt && !Number.isNaN(dt.getTime())
          ? dt.toLocaleTimeString('ru-RU', { hour: '2-digit', minute: '2-digit', second: '2-digit' })
          : 'обновлено';
      }
    } catch {
      renderGatewayStatus({ ok: false, label: 'Шлюз недоступен' });
    }
  }

  document.querySelectorAll('[data-zone-toggle]').forEach(function(btn){
    btn.addEventListener('click', function(){
      const card = btn.closest('[data-zone-card]');
      if (!card) return;
      card.classList.toggle('open');
    });
  });

  function bindOpenButtons(root) {
    (root || document).querySelectorAll('[data-open-device]').forEach(function(btn){
    if (btn.dataset.openBound === '1') return;
    btn.dataset.openBound = '1';
    btn.addEventListener('click', async function(){
      const deviceId = btn.getAttribute('data-device-id');
      const deviceName = btn.getAttribute('data-device-name') || 'Устройство';
      const zoneName = btn.getAttribute('data-device-zone') || '';
      if (!deviceId) return;

      if (btn.dataset.armed !== '1') {
        armedHtml.set(btn, btn.innerHTML);
        btn.dataset.armed = '1';
        btn.classList.add('is-armed');
        btn.innerHTML = '<span class="device-name">Подтвердить</span><span class="device-icon">!</span>';
        setResultState(guidanceForResponse({ tone: 'confirm', deviceName, zoneName }));
        const timer = setTimeout(function(){
          restoreArmed(btn);
          if (resultBox && resultBox.dataset.marker === 'confirm:' + deviceName) {
            setResultState(DEFAULT_RESULT_STATE);
          }
        }, 3200);
        armedTimers.set(btn, timer);
        return;
      }

      const oldHtml = armedHtml.get(btn) || btn.innerHTML;
      restoreArmed(btn);
      btn.disabled = true;
      btn.setAttribute('aria-busy', 'true');
      btn.classList.remove('is-error', 'is-success');
      btn.classList.add('is-pending');
      btn.innerHTML = '<span class="device-name">Отправляем...</span><span class="device-icon">…</span>';
      const icon = btn.querySelector('.device-icon');
      if (icon) icon.textContent = '…';

      try {
        setResultState(guidanceForResponse({ tone: 'pending', deviceName, zoneName }));

        const res = await fetch('/api/open/' + encodeURIComponent(deviceId), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-CSRF-Token': '<%= csrfToken %>'
          },
          body: '{}'
        });

        const data = await res.json().catch(() => ({}));
        const reason = data.reason || (res.status === 403 ? 'denied' : res.status === 404 ? 'missing' : res.status === 409 ? 'disabled' : res.status === 502 ? 'gateway' : '');
        const responseState = guidanceForResponse({
          ok: !!(res.ok && data.ok),
          reason,
          deviceName: data.deviceName || deviceName,
          zoneName: data.zoneName || zoneName,
          requestId: data.requestId,
          elapsedMs: data.elapsed_ms,
          error: data.error || ('HTTP ' + res.status)
        });

        if (res.ok && data.ok) {
          setResultState(responseState);
          upsertRecent({ id: deviceId, name: deviceName, zoneName, requestId: data.requestId || '' });
          if (recentUpdated && data.requestId) recentUpdated.textContent = String(data.requestId).slice(0, 8);
          showCommandToast(responseState);
          refreshDashboardLive();
          btn.classList.remove('is-pending');
          btn.classList.add('is-success');
          btn.innerHTML = '<span class="device-name">Открыто</span><span class="device-icon">✓</span>';

          setTimeout(() => {
            btn.classList.remove('is-success');
            btn.innerHTML = oldHtml;
          }, 1800);
        } else {
          setResultState(responseState);
          showCommandToast(responseState);
          refreshDashboardLive();
          btn.classList.remove('is-pending');
          btn.classList.add('is-error');
          btn.innerHTML = oldHtml;
          setTimeout(() => {
            btn.classList.remove('is-error');
          }, 2400);
        }
      } catch (e) {
        const responseState = guidanceForResponse({
          reason: 'network',
          deviceName,
          zoneName,
          error: e && e.message ? e.message : String(e)
        });
        setResultState(responseState);
        showCommandToast(responseState);
        btn.classList.remove('is-pending');
        btn.classList.add('is-error');
        btn.innerHTML = oldHtml;
        setTimeout(() => {
          btn.classList.remove('is-error');
        }, 2400);
      } finally {
        btn.classList.remove('is-pending');
        btn.disabled = false;
        btn.removeAttribute('aria-busy');
      }
    });
  });
  }

  if (searchInput) {
    searchInput.addEventListener('input', applySearch);
  }

  seedServerRecent();
  renderRecent();
  renderZonePulse(INITIAL_ZONES);
  renderLiveFeed(INITIAL_EVENTS);
  renderTimeline(INITIAL_TIMELINE);
  renderAttention(INITIAL_ATTENTION);
  renderSignalSummary(<%- __safeJson(__stats) %>, INITIAL_EVENTS);
  setResultState(DEFAULT_RESULT_STATE);
  bindZonePulse(document);
  bindSectionJump(document);
  bindJumpTargets(document);
  bindQueryButtons(document);
  bindOpenButtons(document);
  applySearch();
  refreshDashboardLive();
  setInterval(refreshDashboardLive, 15000);
})();
</script>

<%- include('partials/footer') %>
