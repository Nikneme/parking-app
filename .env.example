DATABASE_URL=postgresql://user:password@localhost:5432/parking
DEV_MEMORY_DB=false
ALLOW_DB_INIT_FAILURE=false
SESSION_SECRET=replace-with-a-long-random-secret
DEVICE_SECRET_ENCRYPTION_KEY=replace-with-another-long-random-secret

ADMIN_PHONE=79990000000
ADMIN_PIN=replace-with-strong-admin-password
ADMIN_FIO=Администратор
DISPATCHER_PHONE=+7 936 004-67-42

GATEWAY_BASE_URL=http://127.0.0.1:9090
GATEWAY_KEY=dev-gateway-key
GATEWAY_TIMEOUT_MS=7000
GATEWAY_SEND_DEVICE_SECRETS=false
ALLOW_FILE_TRANSIT_FALLBACK=false
ALLOW_REFERENCE_DEVICE_SEED=false
ALLOW_DEMO_ARTIFACTS=false

START_PIN_TTL_HOURS=24
PIN_MIN_LENGTH=8
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=8
LOGIN_IP_RATE_MAX=40
LOGIN_PHONE_RATE_MAX=24

APP_BASE_URL=http://localhost:8080

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Пароли/PIN по email не отправляются. MAIL_INCLUDE_PASSWORD намеренно не поддерживается.

# Backup/restore scripts
BACKUP_DIR=./backups
