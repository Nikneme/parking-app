  align-items:center;
  margin-top:8px;
  min-height:22px;
  padding:3px 8px;
  border-radius:999px;
  border:1px solid color-mix(in srgb, var(--accent) 24%, var(--field-border));
  background:rgba(255,255,255,.45);
  font-size:11px;
  color:var(--text);
}

.route-chip-title{
  display:block;
  margin-top:4px;
  font-size:14px;
  font-weight:800;
  line-height:1.2;
}

.route-chip-sub{
  display:block;
  margin-top:5px;
  color:var(--muted);
  font-size:12px;
  line-height:1.35;
}

.zone-pulse{
  min-width:0;
  min-height:98px;
  padding:13px 12px;
  border-radius:10px;
  background:var(--field-bg);
  border:1px solid var(--field-border);
  cursor:pointer;
  text-align:left;
  color:var(--text);
}

.zone-pulse:hover{
  border-color:var(--ring);
}

.zone-pulse-name{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:8px;
  font-size:13px;
  font-weight:800;
}

.zone-pulse-count{
  flex:0 0 auto;
  color:var(--muted);
  font-size:11px;
  font-weight:700;
}

.zone-pulse-sub{
  display:block;
  margin-top:6px;
  color:var(--text);
  font-size:12px;
  line-height:1.35;
}

.zone-pulse-last{
  display:block;
  margin-top:7px;
  color:var(--muted);
  font-size:11px;
  line-height:1.35;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.feed-list{
  display:grid;
  gap:8px;
}

.feed-item{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:10px;
  align-items:center;
  padding:10px;
  border-radius:10px;
  background:var(--field-bg);
  border:1px solid var(--field-border);
}

.section-head{
  display:flex;
  flex-wrap:wrap;
  align-items:flex-end;
  justify-content:space-between;
  gap:10px;
  margin:14px 0 10px;
}

.section-head-title{
  font-size:18px;
  font-weight:700;
  line-height:1.2;
}

.section-head-sub{
  margin-top:4px;
  color:var(--muted);
  font-size:13px;
  line-height:1.4;
}

.feed-point{
  font-size:13px;
  font-weight:800;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.feed-meta{
  margin-top:3px;
  color:var(--muted);
  font-size:11px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.feed-result{
  display:inline-flex;
  align-items:center;
  gap:6px;
  min-height:28px;
  padding:5px 8px;
  border-radius:999px;
  border:1px solid var(--field-border);
  background:var(--surface-2);
  color:var(--text);
  font-size:11px;
  white-space:nowrap;
}

.feed-result.is-ok{
  border-color:rgba(53,184,116,.36);
  background:rgba(53,184,116,.12);
}

.feed-result.is-error{
  border-color:rgba(255,107,107,.42);
  background:rgba(255,107,107,.12);
}

.signal-strip{
  display:grid;
  grid-template-columns:repeat(3, minmax(0, 1fr));
  gap:10px;
  margin-bottom:14px;
}

.signal-chip{
  min-width:0;
  padding:12px 12px 10px;
  border-radius:10px;
  border:1px solid var(--field-border);
  background:linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 88%, transparent), color-mix(in srgb, var(--surface) 96%, transparent));
}

.signal-chip-label{
  display:block;
  font-size:11px;
  color:var(--muted);
}

.signal-chip-value{
  display:block;
  margin-top:6px;
  font-size:22px;
  font-weight:800;
  line-height:1;
}

.signal-chip-sub{
  display:block;
  margin-top:5px;
  font-size:11px;
  color:var(--muted);
}

.rhythm-chart{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(42px, 1fr));
  align-items:end;
  gap:10px;
  min-height:146px;
}

.rhythm-col{
  min-width:0;
  display:grid;
  gap:8px;
  justify-items:center;
}

.rhythm-bar{
  position:relative;
  width:100%;
  height:120px;
  padding:6px;
  border-radius:10px;
  border:1px solid var(--field-border);
  background:linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 88%, transparent), color-mix(in srgb, var(--surface) 96%, transparent));
  display:flex;
  align-items:flex-end;
}

.rhythm-bar-fill{
  width:100%;
  border-radius:10px;
  background:linear-gradient(180deg, rgba(88, 191, 255, .88), rgba(42, 138, 255, .52));
  min-height:14px;
}

.rhythm-bar-fill.is-alert{
  background:linear-gradient(180deg, rgba(255, 171, 72, .9), rgba(255, 107, 107, .55));
}

.rhythm-total{
  position:absolute;
  top:8px;
  left:50%;
  transform:translateX(-50%);
  font-size:11px;
  color:var(--muted);
}

.rhythm-label{
  font-size:11px;
  color:var(--muted);
}

.attention-list{
  display:grid;
  gap:8px;
}

.attention-item{
  display:grid;
  grid-template-columns:minmax(0,1fr) auto;
  gap:10px;
  align-items:center;
  padding:11px 12px;
  border-radius:10px;
  border:1px solid rgba(255,171,72,.22);
  background:linear-gradient(180deg, rgba(255,171,72,.12), rgba(255,107,107,.08));
  color:var(--text);
  text-decoration:none;
}

.attention-item:hover{
  border-color:rgba(255,171,72,.42);
}

.attention-point{
  font-size:13px;
  font-weight:800;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.attention-meta{
  margin-top:4px;
  font-size:11px;
  color:var(--muted);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.attention-result{
  display:inline-flex;
  align-items:center;
  min-height:28px;
  padding:5px 9px;
  border-radius:999px;
  border:1px solid rgba(255,171,72,.3);
  background:rgba(255,255,255,.08);
  font-size:11px;
  white-space:nowrap;
}

.attention-empty{
  padding:18px 12px;
  border-radius:10px;
  border:1px dashed var(--field-border);
  background:var(--field-bg);
  color:var(--muted);
  font-size:13px;
  text-align:center;
}

.command-toast{
  position:fixed;
  right:18px;
  bottom:18px;
  z-index:4000;
  display:none;
  width:min(380px, calc(100vw - 32px));
  padding:14px 16px;
  border-radius:12px;
  background:color-mix(in srgb, var(--surface) 94%, transparent);
  border:1px solid var(--border);
  box-shadow:0 24px 80px rgba(0,0,0,.38);
  color:var(--text);
}

.command-toast.show{
  display:block;
}

.command-toast[data-tone="pending"]{
  border-color:rgba(88, 191, 255, .34);
}

.command-toast[data-tone="success"]{
  border-color:rgba(53,184,116,.36);
}

.command-toast[data-tone="warning"]{
  border-color:rgba(245,187,72,.38);
}

.command-toast[data-tone="error"]{
  border-color:rgba(255,107,107,.38);
}

.command-toast-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.command-toast-badge{
  display:inline-flex;
  align-items:center;
  min-height:24px;
  padding:4px 8px;
  border-radius:999px;
  background:var(--surface-2);
  border:1px solid var(--field-border);
  font-size:11px;
  font-weight:700;
}

.command-toast-title{
  font-size:14px;
  font-weight:800;
}

.command-toast-body{
  margin-top:2px;
  color:var(--text);
  font-size:12px;
  line-height:1.45;
}

.command-toast-hint{
  color:var(--muted);
  font-size:12px;
  line-height:1.45;
}

.zone-card.is-hidden,
.device-btn.is-hidden{
  display:none !important;
}

.zone-list{
  display:grid;
  gap:14px;
}

.zone-card{
  border-radius:12px;
  background:var(--card);
  border:1px solid var(--border);
  box-shadow:var(--shadow-card);
  overflow:hidden;
}

.zone-toggle{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  min-height:68px;
  padding:16px 18px;
  background:transparent;
  border:none;
  color:var(--text);
  cursor:pointer;
  text-align:left;
}

.zone-toggle:hover{
  background:var(--accent-ghost);
}

.zone-title-wrap{
  min-width:0;
}

.zone-title{
  font-size:18px;
  font-weight:700;
  line-height:1.2;
}

.zone-sub{
  margin-top:4px;
  font-size:13px;
  color:var(--muted);
}

.zone-arrow{
  flex:0 0 auto;
  font-size:18px;
  transition:transform .18s ease;
  color:var(--muted);
}

.zone-card.open .zone-arrow{
  transform:rotate(180deg);
}

.zone-body{
  display:none;
  padding:0 18px 18px 18px;
  border-top:1px solid var(--border);
}

.zone-card.open .zone-body{
  display:block;
}

.route-sections{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));
  gap:12px;
  margin-top:14px;
}

.route-section{
  min-width:0;
  padding:14px;
  border-radius:12px;
  border:1px solid var(--field-border);
  background:linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 92%, transparent), color-mix(in srgb, var(--surface) 98%, transparent));
}

.route-section.is-hidden{
  display:none !important;
}

.route-section.is-profile{
  border-color:color-mix(in srgb, var(--accent) 32%, var(--field-border));
  background:linear-gradient(180deg, color-mix(in srgb, var(--accent-soft) 78%, var(--surface-2)), color-mix(in srgb, var(--surface) 98%, transparent));
}

.route-section.is-focus{
  border-color:var(--ring);
  box-shadow:0 0 0 3px color-mix(in srgb, var(--accent) 16%, transparent);
}

.route-section-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:10px;
  margin-bottom:12px;
}

.route-section-title{
  font-size:15px;
  font-weight:800;
  line-height:1.2;
}

.route-section-sub{
  margin-top:4px;
  color:var(--muted);
  font-size:12px;
  line-height:1.35;
}

.route-section-count{
  flex:0 0 auto;
  min-width:30px;
  text-align:center;
  padding:5px 8px;
  border-radius:999px;
  border:1px solid var(--field-border);
  background:var(--field-bg);
  color:var(--muted);
  font-size:11px;
  font-weight:700;
}

.route-section-tag{
  display:inline-flex;
  align-items:center;
  margin-top:8px;
  min-height:22px;
  padding:3px 8px;
  border-radius:999px;
  border:1px solid color-mix(in srgb, var(--accent) 24%, var(--field-border));
  background:rgba(255,255,255,.45);
  font-size:11px;
  color:var(--text);
}

.route-section .device-grid{
  grid-template-columns:1fr;
  margin-top:0;
}

.device-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
  gap:12px;
  margin-top:14px;
}

.device-btn{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  min-height:56px;
  padding:14px 14px;
  border-radius:10px;
  border:1px solid var(--field-border);
  background:var(--field-bg);
  color:var(--text);
  cursor:pointer;
  text-align:left;
  transition:transform .08s ease, box-shadow .15s ease, border-color .15s ease, background .15s ease;
}

.device-btn:hover{
  transform:translateY(-1px);
  box-shadow:0 10px 24px rgba(0,0,0,.14);
  border-color:var(--ring);
}

.device-btn:disabled{
  opacity:.65;
  cursor:default;
  transform:none;
  box-shadow:none;
}

.device-btn.is-success{
  border-color:#35b874 !important;
  background:rgba(31,143,87,.18) !important;
}

.device-btn.is-pending{
  border-color:rgba(88, 191, 255, .4) !important;
  background:rgba(88, 191, 255, .12) !important;
}

.device-btn.is-armed{
  border-color:#f5bb48 !important;
  background:rgba(245,187,72,.14) !important;
}

.device-btn.is-error{
  border-color:rgba(255,107,107,.4) !important;
  background:rgba(255,107,107,.12) !important;
}

.device-name{
  font-weight:600;
  line-height:1.25;
  min-width:0;
}

.device-icon{
  flex:0 0 auto;
  width:32px;
  height:32px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  border-radius:999px;
  background:var(--surface-2);
  opacity:1;
}

.empty-zone{
  margin-top:14px;
  color:var(--muted);
  font-size:14px;
}

.result-note{
  margin-top:14px;
  display:grid;
  gap:8px;
  padding:14px 16px;
  border-radius:12px;
  border:1px solid var(--field-border);
  background:linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 92%, transparent), color-mix(in srgb, var(--surface) 96%, transparent));
  box-shadow:var(--shadow-card);
}

.result-note[data-tone="idle"]{
  border-color:var(--field-border);
}

.result-note[data-tone="pending"]{
  border-color:rgba(88, 191, 255, .34);
  background:linear-gradient(180deg, rgba(88, 191, 255, .14), color-mix(in srgb, var(--surface) 96%, transparent));
}

.result-note[data-tone="success"]{
  border-color:rgba(53,184,116,.34);
  background:linear-gradient(180deg, rgba(53,184,116,.14), color-mix(in srgb, var(--surface) 96%, transparent));
}

.result-note[data-tone="warning"]{
  border-color:rgba(245,187,72,.34);
  background:linear-gradient(180deg, rgba(245,187,72,.15), color-mix(in srgb, var(--surface) 96%, transparent));
}

.result-note[data-tone="error"]{
  border-color:rgba(255,107,107,.34);
  background:linear-gradient(180deg, rgba(255,107,107,.14), color-mix(in srgb, var(--surface) 96%, transparent));
}

.result-note-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  flex-wrap:wrap;
}

.result-note-badge{
  display:inline-flex;
  align-items:center;
  min-height:24px;
  padding:4px 8px;
  border-radius:999px;
  border:1px solid var(--field-border);
  background:var(--field-bg);
  font-size:11px;
  font-weight:700;
}

.result-note-code{
  color:var(--muted);
  font-size:11px;
  font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}

.result-note-title{
  font-size:15px;
  font-weight:800;
  line-height:1.3;
}

.result-note-body{
  font-size:13px;
  line-height:1.45;
}

.result-note-hint{
  font-size:12px;
  line-height:1.45;
  color:var(--muted);
}

.euro-layout{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:14px;
  margin-top:14px;
  align-items:start;
}

.euro-col-title{
  font-size:12px;
  color:var(--muted);
  margin:0 0 8px;
  text-transform:uppercase;
  letter-spacing:.04em;
}

.euro-layout .device-grid{
  grid-template-columns:1fr;
  margin-top:0;
}

@media (max-width: 768px){
  .ops-head,
  .ops-workbar,
  .command-center,
  .signal-grid{
    grid-template-columns:1fr;
  }

  .ops-stats{
    grid-template-columns:1fr 1fr;
  }

  .ops-title h1{
    font-size:22px;
  }

  .ops-actions{
    display:grid;
    grid-template-columns:1fr 1fr;
  }

  .ops-search-row{
    display:grid;
    grid-template-columns:1fr;
  }

  .ops-search-count{
    min-width:0;
    text-align:left;
  }

  .zone-toggle{
    padding:14px 14px;
  }

  .zone-title{
    font-size:17px;
  }

  .zone-body{
    padding:0 14px 14px 14px;
  }

  .device-grid{
    grid-template-columns:1fr;
  }

  .route-strip,
  .zone-pulse-grid{
    grid-template-columns:1fr;
  }

  .ops-action{
    width:100%;
    min-width:0;
    white-space:normal;
    text-align:center;
  }

  .euro-layout{
    grid-template-columns:1fr 1fr;
    gap:10px;
  }

  .euro-layout .device-grid{
    grid-template-columns:1fr;
  }

  .signal-strip{
    grid-template-columns:1fr;
  }
}
</style>

<div class="dashboard-page">
  <div class="ops-panel">
    <div class="ops-head">
      <div class="ops-title">
        <span class="ops-kicker"><%= __isTenant ? 'Ваш маршрут' : 'Удаленное управление' %></span>
        <h1><%= __introTitle %></h1>
        <p class="ops-lead"><%= __introLead %></p>
        <% if (!__isTenant) { %>
        <div class="ops-meta">
            <span class="ops-pill" id="gatewayStatus">
              <span class="ops-dot"></span>
              <span id="gatewayStatusText"><%= __stats.gatewayConfigured ? 'Шлюз проверяется' : 'Шлюз не настроен' %></span>
            </span>
            <% if (__lastEvent) { %>
              <span class="ops-pill">
                <span class="ops-dot"></span>
                <span>Последняя команда: <%= (__lastEvent.datetime_msk || '').toString().split(' ').slice(1).join(' ') || '—' %></span>
              </span>
            <% } %>
        </div>
        <% } %>
        <% if (!__isTenant) { %>
          <div class="ops-actions">
            <button type="button" class="ops-action" data-jump-target="dashboardSearch">Найти</button>
            <button type="button" class="ops-action" data-jump-target="zonePulseGrid">Открыть</button>
            <button type="button" class="ops-action" data-jump-target="liveFeedList">Недавние</button>
            <% if (__showOperatorPanels) { %>
              <button type="button" class="ops-action" data-jump-target="attentionList">Проблемы</button>
            <% } %>
            <a class="ops-action" href="/logs">Журнал</a>
          </div>
        <% } %>
      </div>
    </div>

    <div class="ops-workbar">
      <div class="ops-search">
        <div class="ops-search-row">
          <input id="dashboardSearch" type="search" placeholder="<%= __isTenant ? 'Например: 7 этаж, вход, Ш1' : 'Например: Ш1, дверь 1, 7 этаж' %>" autocomplete="off" autocapitalize="none">
          <div class="ops-search-count" id="dashboardSearchCount" <%= __isTenant ? 'hidden' : '' %>><%= __isTenant ? '' : ('Устройств: ' + (__stats.devices || 0)) %></div>
        </div>
      </div>

      <div class="ops-recent">
        <div class="recent-title">
          <strong><%= __isTenant ? 'Недавно открывали' : 'Недавние команды' %></strong>
          <span class="recent-code" id="recentUpdated"><%= __isTenant ? '' : (__lastEvent && __lastEvent.request_id ? String(__lastEvent.request_id).slice(0, 8) : '') %></span>
        </div>
        <div class="recent-quick-list" id="recentQuickList"></div>
        <% if (__recentEvents.length) { %>
          <div class="recent-list" id="serverRecentList">
            <% __recentEvents.slice(0, 3).forEach(function(e){ 
              const _rid = e.request_id ? String(e.request_id).slice(0, 8) : '';
            %>
              <div class="recent-row">
                <div class="recent-main">
                  <div class="recent-name"><%= e.point || '—' %></div>
                  <div class="recent-sub"><%= e.actor_fio || e.source || '—' %> • <%= e.result_label || e.result || '—' %></div>
                </div>
                <div class="recent-code"><%= _rid %></div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>

    <% if (__isTenant && (__tenantPrimaryFloor || __supportContact)) { %>
      <div class="tenant-action-strip">
        <% if (__tenantPrimaryFloor) { %>
          <button type="button" class="tenant-action-card" data-apply-query="<%= __tenantPrimaryFloor %> этаж">
            <span class="tenant-action-copy">
              <span class="tenant-action-title">Показать <%= __tenantPrimaryFloor %> этаж</span>
              <span class="tenant-action-sub">Оставить на экране только подходящие въезды, выезды и проходы.</span>
            </span>
            <span class="tenant-action-icon">→</span>
          </button>
        <% } %>
        <% if (__supportContact && __supportContact.tel_href) { %>
          <a class="tenant-action-card is-call" href="<%= __supportContact.tel_href %>">
            <span class="tenant-action-copy">
              <span class="tenant-action-title">Позвонить диспетчеру</span>
              <span class="tenant-action-sub"><%= __supportContact.phone_display || __supportContact.phone %></span>
            </span>
            <span class="tenant-action-icon">Тел</span>
          </a>
        <% } %>
      </div>
    <% } %>
    <% if (__isTenant && __tenantProfile.hasProfile) { %>
      <div class="tenant-context-strip">
        <% if (__tenantProfile.parking_floors.length) { %>
          <button type="button" class="tenant-context-chip" data-apply-query="<%= __tenantProfile.parking_floors[0] %> этаж"><span class="tenant-context-label">Этаж</span><strong><%= __tenantProfile.parking_floors.join(', ') %></strong></button>
        <% } %>
        <% if (__tenantProfile.parking_groups.length) { %>
          <button type="button" class="tenant-context-chip" data-apply-query="<%= __tenantProfile.parking_groups[0] %>"><span class="tenant-context-label">Группа мест</span><strong><%= __tenantProfile.parking_groups.join(', ') %></strong></button>
        <% } %>
        <% if (__tenantProfile.parking_spots.length) { %>
          <button type="button" class="tenant-context-chip" data-apply-query="<%= __tenantProfile.parking_spots[0] %>"><span class="tenant-context-label">Места</span><strong><%= __tenantProfile.parking_spots.join(', ') %></strong></button>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="command-center <%= __isTenant ? 'is-tenant' : '' %>">
    <div class="center-panel">
      <div class="center-head">
        <strong><%= __isTenant ? 'Быстро открыть' : 'Где открыть' %></strong>
        <% if (!__isTenant) { %>
          <span class="center-sub" id="liveGeneratedAt">обновляется</span>
        <% } %>
      </div>
      <% if (__isTenant && __tenantQuickRoutes.length) { %>
        <div class="route-strip" id="tenantQuickRoutes">
          <% __tenantQuickRoutes.forEach(function(route){ %>
            <button
              type="button"
              class="route-chip <%= route.isProfileMatch ? 'is-profile' : '' %>"
              data-jump-section="<%= route.id %>"
              data-route-search="<%= route.searchText %>">
              <span class="route-chip-zone"><%= route.zoneName %></span>
              <span class="route-chip-title"><%= route.title %></span>
              <span class="route-chip-sub"><%= route.subtitle %> • <%= route.count %> <%= __pluralRu(route.count, 'вариант', 'варианта', 'вариантов') %></span>
              <% if (route.isProfileMatch) { %><span class="route-chip-flag">Мой маршрут</span><% } %>
            </button>
          <% }) %>
        </div>
      <% } %>
      <% if (!__isTenant) { %>
        <div class="zone-pulse-grid" id="zonePulseGrid">
          <% __zoneSummary.forEach(function(z){ %>
            <button type="button" class="zone-pulse" data-jump-zone="<%= z.id %>">
              <span class="zone-pulse-name">
                <span><%= z.name %></span>
                <span class="zone-pulse-count"><%= z.devices %></span>
              </span>
              <span class="zone-pulse-sub"><%= z.descriptor || (z.devices + ' вариантов') %></span>
              <% if (z.lastPoint) { %>
                <span class="zone-pulse-last"><%= z.lastPoint %> • <%= z.lastResult || '—' %></span>
              <% } %>
            </button>
          <% }) %>
        </div>
      <% } %>
    </div>

    <% if (__showOperatorPanels) { %>
    <div class="center-panel">
      <div class="center-head">
        <strong>Лента команд</strong>
        <span class="center-sub" id="liveFeedState"><%= __clientRecentEvents.length ? 'последние события' : 'ожидает события' %></span>
      </div>
      <div class="feed-list" id="liveFeedList">
        <% __clientRecentEvents.slice(0, 5).forEach(function(e){ 
          const _ok = String(e.result || '').toLowerCase() === 'ok';
          const _rid = e.request_id ? String(e.request_id).slice(0, 8) : '';
        %>
          <div class="feed-item">
            <div>
              <div class="feed-point"><%= e.point || '—' %></div>
              <div class="feed-meta"><%= e.datetime_msk || '—' %> • <%= e.actor_fio || e.actor_phone || '—' %></div>
            </div>
            <div class="feed-result <%= _ok ? 'is-ok' : 'is-error' %>"><%= e.result_label || e.result || '—' %><% if (_rid) { %> #<%= _rid %><% } %></div>
          </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>

  <div class="dashboard-empty-search" id="dashboardNoMatches">Ничего не найдено. Попробуйте этаж, вход, шлагбаум или код вроде Ш1.</div>
  <div class="dashboard-search-help" id="dashboardSearchHelp">
    <div class="dashboard-search-help-title" id="dashboardSearchHelpTitle"></div>
    <div class="dashboard-search-help-chips" id="dashboardSearchHelpChips"></div>
  </div>

  <div class="section-head">
    <div>
      <div class="section-head-title"><%= __isTenant ? 'Что можно открыть' : 'Все точки открытия' %></div>
      <div class="section-head-sub"><%= __isTenant ? (__tenantProfile.hasProfile ? 'Сначала ваши варианты. Ниже — остальные входы, въезды и шлагбаумы.' : 'Ниже собраны все варианты: въезды, двери, лифты и шлагбаумы.') : 'Все команды сгруппированы по разделам, чтобы быстрее находить нужное действие.' %></div>
    </div>
  </div>
  <div class="zone-list">
    <% if (byZone && byZone.length) { %>
      <% byZone.forEach(function(group, idx){ 
           const devices = __sortDashboardDevices(Array.isArray(group.devices) ? group.devices : []);
           const zoneMeta = __zoneSummaryById[group.zoneId] || null;
           const zoneRoutes = __zoneRoutesById[group.zoneId] || { sections: [] };
           const shouldOpenZone = __isTenant || idx === 0;
      %>
        <div class="zone-card <%= shouldOpenZone ? 'open' : '' %>" data-zone-card data-zone-id="<%= group.zoneId %>" data-zone-name="<%= group.zoneName %>">
          <button type="button" class="zone-toggle" data-zone-toggle>
            <div class="zone-title-wrap">
              <div class="zone-title"><%= group.zoneName %></div>
              <div class="zone-sub"><%= zoneMeta && zoneMeta.descriptor ? zoneMeta.descriptor : (devices.length + ' вариантов') %></div>
            </div>
            <div class="zone-arrow">⌄</div>
          </button>

          <div class="zone-body">
            <% if (devices.length) { %>
              <div class="route-sections">
                <% zoneRoutes.sections.forEach(function(section){ %>
                  <div
                    class="route-section <%= section.isProfileMatch ? 'is-profile' : '' %>"
                    data-route-section
                    data-route-section-id="<%= section.id %>"
                    data-route-search="<%= section.searchText %>"
                    data-route-local-search="<%= section.localSearchText %>">
                    <div class="route-section-head">
                      <div>
                        <div class="route-section-title"><%= section.title %></div>
                        <div class="route-section-sub"><%= section.subtitle %></div>
                        <% if (section.isProfileMatch) { %><div class="route-section-tag">Мой маршрут</div><% } %>
                      </div>
                      <div class="route-section-count"><%= section.count %></div>
                    </div>
                    <div class="device-grid">
                      <% section.devices.forEach(function(device){ %>
                        <button
                          type="button"
                          class="device-btn"
                          data-open-device
                          data-device-id="<%= device.id %>"
                          data-device-name="<%= device.name %>"
                          data-device-zone="<%= group.zoneName %>"
                          data-device-search="<%= [device.name, (__isTenant ? '' : device.id), group.zoneName, section.title, section.subtitle].filter(Boolean).join(' ').toLowerCase() %>">
                          <span class="device-name"><%= device.name %></span>
                          <span class="device-icon">→</span>
                        </button>
                      <% }) %>
                    </div>
                  </div>
                <% }) %>
              </div>

            <% } else { %>
              <div class="empty-zone">В этом разделе пока ничего не подключено.</div>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="card">
        <div class="text-muted">Для вас пока ничего не настроено.</div>
      </div>
    <% } %>
  </div>

  <% if (__showOperatorPanels) { %>
  <div class="signal-grid">
    <div class="center-panel">
      <div class="center-head">
        <strong>Ритм объекта</strong>
        <span class="center-sub">по последним командам</span>
      </div>
      <div class="signal-strip">
        <div class="signal-chip">
          <span class="signal-chip-label">Успешно</span>
          <span class="signal-chip-value" id="signalOkCount"><%= __stats.okCount || 0 %></span>
          <span class="signal-chip-sub">стабильные срабатывания</span>
        </div>
        <div class="signal-chip">
          <span class="signal-chip-label">Внимание</span>
          <span class="signal-chip-value" id="signalAttentionCount"><%= __stats.attentionCount || 0 %></span>
          <span class="signal-chip-sub">отказы и ошибки шлюза</span>
        </div>
        <div class="signal-chip">
          <span class="signal-chip-label">Последняя активность</span>
          <span class="signal-chip-value" id="signalLastTime"><%= (__lastEvent && ((__lastEvent.datetime_msk || '').toString().split(' ').slice(1).join(' '))) || '—' %></span>
          <span class="signal-chip-sub">обновляется вместе с live</span>
        </div>
      </div>
      <div class="rhythm-chart" id="rhythmChart">
        <% __timeline.forEach(function(item){ %>
          <div class="rhythm-col">
            <div class="rhythm-bar">
              <span class="rhythm-total"><%= item.total %></span>
              <div class="rhythm-bar-fill <%= item.attention ? 'is-alert' : '' %>" style="height:<%= item.height %>%"></div>
            </div>
            <div class="rhythm-label"><%= item.label %></div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="center-panel">
      <div class="center-head">
        <strong>Требуют внимания</strong>
        <a class="center-sub" href="/logs?status=attention">в журнал</a>
      </div>
      <div class="attention-list" id="attentionList">
        <% if (__attentionEvents.length) { %>
          <% __attentionEvents.forEach(function(item){ %>
            <a class="attention-item" href="<%= item.logs_href || '/logs?status=attention' %>">
              <div>
                <div class="attention-point"><%= item.point || '—' %></div>
                <div class="attention-meta"><%= item.datetime_msk || '—' %> • <%= item.actor_fio || item.actor_phone || '—' %></div>
              </div>
              <div class="attention-result"><%= item.result_label || item.result || '—' %></div>
            </a>
          <% }) %>
        <% } else { %>
          <div class="attention-empty">Проблемных событий в live-окне нет</div>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <div class="result-note" id="dashboardResult" role="status" aria-live="polite" data-tone="idle">
    <div class="result-note-head">
      <span class="result-note-badge" id="dashboardResultBadge">Готово к команде</span>
      <span class="result-note-code" id="dashboardResultCode"></span>
    </div>
    <div class="result-note-title" id="dashboardResultTitle"><%= __isTenant ? 'Выберите нужную дверь, шлагбаум или въезд.' : 'Выберите устройство и отправьте команду.' %></div>
    <div class="result-note-body" id="dashboardResultBody"><%= __isTenant ? 'Сначала приложение попросит подтвердить действие, чтобы не было случайного открытия.' : 'Перед выполнением команда попросит подтверждение, а затем покажет результат без технического шума.' %></div>
    <div class="result-note-hint" id="dashboardResultHint">После каждого действия здесь будет ясно, что произошло и что делать дальше.</div>
  </div>
</div>

<div class="command-toast" id="commandToast" role="status" aria-live="polite" data-tone="idle">
  <div class="command-toast-head">
    <span class="command-toast-badge" id="commandToastBadge">Статус</span>
    <span class="recent-code" id="commandToastCode"></span>
  </div>
  <div class="command-toast-title" id="commandToastTitle">Команда выполнена</div>
  <div class="command-toast-body" id="commandToastBody"></div>
  <div class="command-toast-hint" id="commandToastHint"></div>
</div>

<script>
(function(){
  const KNOWN_DEVICES = <%- __safeJson(__devicesForJson) %>;
  const SERVER_RECENT = <%- __safeJson(__recentDeviceActions) %>;
  const INITIAL_EVENTS = <%- __safeJson(__clientRecentEvents) %>;
  const INITIAL_ZONES = <%- __safeJson(__zoneSummary) %>;
  const INITIAL_TIMELINE = <%- __safeJson(__timeline) %>;
  const INITIAL_ATTENTION = <%- __safeJson(__attentionEvents) %>;
  const dashboardPage = document.querySelector('.dashboard-page');
  const resultBox = document.getElementById('dashboardResult');
  const resultBadge = document.getElementById('dashboardResultBadge');
  const resultCode = document.getElementById('dashboardResultCode');
  const resultTitle = document.getElementById('dashboardResultTitle');
  const resultBody = document.getElementById('dashboardResultBody');
  const resultHint = document.getElementById('dashboardResultHint');
  const searchInput = document.getElementById('dashboardSearch');
  const searchCount = document.getElementById('dashboardSearchCount');
  const noMatches = document.getElementById('dashboardNoMatches');
  const searchHelp = document.getElementById('dashboardSearchHelp');
  const searchHelpTitle = document.getElementById('dashboardSearchHelpTitle');
  const searchHelpChips = document.getElementById('dashboardSearchHelpChips');
  const recentQuickList = document.getElementById('recentQuickList');
  const serverRecentList = document.getElementById('serverRecentList');
  const recentUpdated = document.getElementById('recentUpdated');
  const tenantQuickRoutes = document.getElementById('tenantQuickRoutes');
  const gatewayStatus = document.getElementById('gatewayStatus');
  const gatewayStatusText = document.getElementById('gatewayStatusText');
  const zonePulseGrid = document.getElementById('zonePulseGrid');
  const liveFeedList = document.getElementById('liveFeedList');
  const liveFeedState = document.getElementById('liveFeedState');
  const liveGeneratedAt = document.getElementById('liveGeneratedAt');
  const rhythmChart = document.getElementById('rhythmChart');
  const attentionList = document.getElementById('attentionList');
  const signalOkCount = document.getElementById('signalOkCount');
  const signalAttentionCount = document.getElementById('signalAttentionCount');
  const signalLastTime = document.getElementById('signalLastTime');
  const commandToast = document.getElementById('commandToast');
  const commandToastBadge = document.getElementById('commandToastBadge');
  const commandToastTitle = document.getElementById('commandToastTitle');
  const commandToastCode = document.getElementById('commandToastCode');
  const commandToastBody = document.getElementById('commandToastBody');
  const commandToastHint = document.getElementById('commandToastHint');
  const armedTimers = new WeakMap();
  const armedHtml = new WeakMap();
  const RECENT_KEY = 'parking.dashboard.recent.v1';
  const searchCountPrefix = <%- JSON.stringify(__isTenant ? '' : 'Устройств: ') %>;
  const SUPPORT_CONTACT = <%- JSON.stringify(__supportContact || null) %>;
  let toastTimer = null;
  const DEFAULT_RESULT_STATE = {
    tone: 'idle',
    badge: 'Готово к команде',
    title: <%- JSON.stringify(__isTenant ? 'Выберите нужную дверь, шлагбаум или въезд.' : 'Выберите устройство и отправьте команду.') %>,
    body: <%- JSON.stringify(__isTenant ? 'Сначала приложение попросит подтвердить действие, чтобы не было случайного открытия.' : 'Перед выполнением команда попросит подтверждение, а затем покажет результат без технического шума.') %>,
    hint: 'После каждого действия здесь будет ясно, что произошло и что делать дальше.',
    requestId: '',
    marker: 'idle'
  };

  function restoreArmed(btn) {
    const timer = armedTimers.get(btn);
    if (timer) clearTimeout(timer);
    armedTimers.delete(btn);
    btn.classList.remove('is-armed');
    btn.dataset.armed = '0';
    const html = armedHtml.get(btn);
    if (html) btn.innerHTML = html;
  }

  function readRecent() {
    try {
      const parsed = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function writeRecent(items) {
    try {
      localStorage.setItem(RECENT_KEY, JSON.stringify(items.slice(0, 6)));
    } catch {}
  }

  function deviceById(id) {
    const needle = String(id || '');
    return KNOWN_DEVICES.find((device) => String(device.id) === needle) || null;
  }

  function upsertRecent(item) {
    const clean = {
      id: String(item.id || ''),
      name: String(item.name || ''),
      zoneName: String(item.zoneName || ''),
      requestId: String(item.requestId || ''),
      ts: item.ts || new Date().toISOString(),
    };
    if (!clean.id) return;

    const next = [clean].concat(readRecent().filter((x) => String(x.id) !== clean.id));
    writeRecent(next);
    renderRecent();
  }

  function seedServerRecent() {
    if (!SERVER_RECENT.length || readRecent().length) return;
    const seed = SERVER_RECENT.map((item) => {
      const device = deviceById(item.id);
      return {
        id: item.id,
        name: device?.name || item.name,
        zoneName: device?.zoneName || item.zoneName,
        requestId: item.requestId || '',
        ts: item.ts || '',
      };
    });
    writeRecent(seed);
  }

  function renderRecent() {
    if (!recentQuickList) return;
    const items = readRecent()
      .map((item) => ({ ...item, device: deviceById(item.id) }))
      .filter((item) => item.device);

    recentQuickList.innerHTML = '';
    if (!items.length) {
      if (serverRecentList) serverRecentList.style.display = '';
      return;
    }

    if (serverRecentList) serverRecentList.style.display = 'none';
    items.slice(0, 4).forEach((item) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'recent-quick-btn';
      button.setAttribute('data-open-device', '');
      button.setAttribute('data-device-id', item.device.id);
      button.setAttribute('data-device-name', item.device.name || item.name);
      button.setAttribute('data-device-zone', item.device.zoneName || item.zoneName || '');
      button.setAttribute('data-device-search', [item.device.name, (<%- JSON.stringify(__isTenant) %> ? '' : item.device.id), item.device.zoneName].filter(Boolean).join(' ').toLowerCase());
      button.innerHTML =
        '<span class="recent-main">' +
          '<span class="recent-name">' + escapeHtml(item.device.name || item.name || item.id) + '</span>' +
          '<span class="recent-sub">' + escapeHtml(item.device.zoneName || item.zoneName || '') + '</span>' +
        '</span>' +
        '<span class="device-icon">→</span>';
      recentQuickList.appendChild(button);
    });
    bindOpenButtons(recentQuickList);
  }

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, function (ch) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch];
    });
  }

  function shortRequestId(value) {
    return value ? String(value).slice(0, 8) : '';
  }

  function setResultState(state) {
    if (!resultBox) return;
    const next = Object.assign({}, DEFAULT_RESULT_STATE, state || {});
    resultBox.dataset.tone = next.tone || 'idle';
    resultBox.dataset.marker = next.marker || '';
    if (resultBadge) resultBadge.textContent = next.badge || DEFAULT_RESULT_STATE.badge;
    if (resultCode) resultCode.textContent = next.requestId ? '#' + shortRequestId(next.requestId) : '';
    if (resultTitle) resultTitle.textContent = next.title || DEFAULT_RESULT_STATE.title;
    if (resultBody) resultBody.textContent = next.body || '';
    if (resultHint) resultHint.textContent = next.hint || '';
  }

  function supportHint(base) {
    const text = String(base || '').trim();
    if (!SUPPORT_CONTACT || !SUPPORT_CONTACT.phone_display) return text;
    return text
      ? (text + ' Диспетчер: ' + SUPPORT_CONTACT.phone_display + '.')
      : ('Диспетчер: ' + SUPPORT_CONTACT.phone_display + '.');
  }

  function guidanceForResponse(options) {
    const tone = options?.tone || 'idle';
    const deviceName = options?.deviceName || 'Устройство';
    const zoneName = options?.zoneName || '';
    const requestId = options?.requestId || '';
    const elapsedMs = Number.isFinite(Number(options?.elapsedMs)) ? Number(options.elapsedMs) : null;
    const detailBits = [zoneName];
    if (elapsedMs !== null) detailBits.push('Ответ за ' + elapsedMs + ' мс');

    if (tone === 'pending') {
      return {
        tone,
        badge: 'Отправляем команду',
        title: 'Открываем: ' + deviceName,
        body: detailBits.filter(Boolean).join(' • ') || 'Ждем ответ от объекта.',
        hint: 'Не закрывайте экран, пока не придет ответ.',
        requestId,
        marker: 'pending:' + deviceName
      };
    }

    if (tone === 'confirm') {
      return {
        tone: 'warning',
        badge: 'Нужно подтвердить',
        title: 'Нажмите еще раз, чтобы открыть: ' + deviceName,
        body: zoneName || 'Это защита от случайного нажатия.',
        hint: 'Если передумали, просто подождите пару секунд.',
        requestId,
        marker: 'confirm:' + deviceName
      };
    }

    if (options?.reason === 'denied') {
      return {
        tone: 'error',
        badge: 'Нет доступа',
        title: deviceName + ' не открылся',
        body: 'У вас нет прав на этот проход или проезд.',
        hint: supportHint('Выберите свой маршрут или обратитесь к администратору парковки.'),
        requestId,
        marker: 'result:' + requestId
      };
    }

    if (options?.reason === 'disabled') {
      return {
        tone: 'warning',
        badge: 'Временно отключено',
        title: deviceName + ' сейчас недоступен',
        body: zoneName || 'Этот вход или проезд временно отключен.',
        hint: supportHint('Попробуйте соседний маршрут или свяжитесь с диспетчером.'),
        requestId,
        marker: 'result:' + requestId
      };
    }

    if (options?.reason === 'missing') {
      return {
        tone: 'error',
        badge: 'Уже недоступно',
        title: deviceName + ' больше не найден',
        body: 'Экран устарел или этот элемент уже убрали из системы.',
        hint: 'Обновите страницу и выберите другой вариант.',
        requestId,
        marker: 'result:' + requestId
      };
    }

    if (options?.reason === 'gateway') {
      return {
        tone: 'error',
        badge: 'Нет связи с объектом',
        title: deviceName + ' не ответил',
        body: detailBits.filter(Boolean).join(' • ') || 'Сейчас нет ответа от шлюза объекта.',
        hint: supportHint('Ничего не открылось. Подождите несколько секунд и попробуйте снова.'),
        requestId,
        marker: 'result:' + requestId
      };
    }

    if (options?.reason === 'network') {
      return {
        tone: 'error',
        badge: 'Ошибка сети',
        title: 'Команда не дошла до сервера',
        body: options?.error || 'Связь с приложением прервалась.',
        hint: supportHint('Проверьте интернет и повторите команду еще раз.'),
        requestId,
        marker: 'result:' + requestId
      };
    }

    if (options?.ok) {
      return {
        tone: 'success',
        badge: 'Открыто',
        title: deviceName + ' открыт',
        body: detailBits.filter(Boolean).join(' • ') || 'Команда принята объектом.',
        hint: supportHint('Если проход не сработал, повторите команду или свяжитесь с диспетчером.'),
        requestId,
        marker: 'result:' + requestId
      };
    }

    return {
      tone: 'error',
      badge: 'Не получилось',
      title: deviceName + ' не открылся',
      body: options?.error || 'Система не смогла выполнить команду.',
      hint: 'Повторите попытку чуть позже.',
      requestId,
      marker: 'result:' + requestId
    };
  }

  function renderGatewayStatus(data) {
    if (!gatewayStatus || !gatewayStatusText) return;
    const ok = !!data?.ok;
    gatewayStatus.classList.toggle('is-online', ok);
    gatewayStatus.classList.toggle('is-offline', !ok);
    const ms = Number.isFinite(Number(data?.elapsed_ms)) ? ' • ' + Number(data.elapsed_ms) + ' мс' : '';
