  flex-wrap:wrap;
  gap:8px;
}

.search-help-chip{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:38px;
  padding:8px 12px;
  border-radius:999px;
  border:1px solid color-mix(in srgb, var(--accent) 24%, var(--field-border));
  background:rgba(255,255,255,.42);
  color:var(--text);
  font-size:13px;
  font-weight:600;
  cursor:pointer;
}

.command-center{
  display:grid;
  grid-template-columns:minmax(0,1fr) minmax(300px,.9fr);
