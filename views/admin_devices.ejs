<%- include('partials/header', { title, bodyClass, user, path: '/admin/devices' }) %>

<% const _devices = Array.isArray(devices) ? devices : []; %>
<% const _activeDevices = _devices.filter(d => d && d.is_active !== false).length; %>
<% const _inactiveDevices = _devices.length - _activeDevices; %>

<div class="mb-3">
  <div class="d-flex flex-wrap gap-2 align-items-start justify-content-between">
    <div>
      <h1 class="h4 mb-0">РЈСЃС‚СЂРѕР№СЃС‚РІР°</h1>
      <div class="text-muted small">Р”РІРµСЂРё, Р»РёС„С‚С‹, РІРѕСЂРѕС‚Р° Рё С€Р»Р°РіР±Р°СѓРјС‹ РїРѕ СѓС‡Р°СЃС‚РєР°Рј.</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <span class="badge-soft px-3 py-2">Р’СЃРµРіРѕ: <%= _devices.length %></span>
      <span class="badge-soft px-3 py-2">РђРєС‚РёРІРЅС‹: <%= _activeDevices %></span>
      <span class="badge-soft px-3 py-2">РћС‚РєР»СЋС‡РµРЅС‹: <%= _inactiveDevices %></span>
    </div>
  </div>
</div>

<div class="card card-glass p-3 p-md-4 mb-3">
  <h2 class="h6 mb-3">Р”РѕР±Р°РІРёС‚СЊ СѓСЃС‚СЂРѕР№СЃС‚РІРѕ</h2>
  <form method="post" action="/admin/devices/create" class="row g-2">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="col-12 col-md-3">
      <label class="form-label small text-muted">ID</label>
      <input class="form-control" name="id" placeholder="door_1" />
    </div>
    <div class="col-12 col-md-4">
      <label class="form-label small text-muted">РќР°Р·РІР°РЅРёРµ</label>
      <input class="form-control" name="name" placeholder="Р”РІРµСЂСЊ СЃРµСЂРІРµСЂРЅР°СЏ" required />
    </div>
    <div class="col-12 col-md-3">
      <label class="form-label small text-muted">РЈС‡Р°СЃС‚РѕРє</label>
      <select class="form-select" name="zoneId">
        <option value="">вЂ”</option>
        <% (zones || []).forEach(z => { %>
          <option value="<%= z.id %>"><%= z.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-12 col-md-2">
      <label class="form-label small text-muted">РњРµС‚РѕРґ</label>
      <select class="form-select" name="method">
        <option value="http">http</option>
        <option value="rodos">rodos</option>
      </select>
    </div>
    <div class="col-12">
      <label class="form-label small text-muted">URL/IP</label>
      <input class="form-control" name="url" placeholder="http://... РёР»Рё 192.168.1.10" />
    </div>
    <div class="col-12">
      <button class="btn btn-primary w-100 w-md-auto" type="submit">РЎРѕС…СЂР°РЅРёС‚СЊ</button>
    </div>
  </form>
</div>

<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-2">
  <div class="text-muted small">Р’СЃРµРіРѕ СѓСЃС‚СЂРѕР№СЃС‚РІ: <%= (devices || []).length %></div>
  <div style="flex: 1 1 280px; max-width: 380px;">
    <input id="devicesSearch" class="form-control" placeholder="РџРѕРёСЃРє: РЁ1, Р»РёС„С‚, 8 СЌС‚Р°Р¶, РІСЉРµР·Рґ" />
  </div>
</div>

<div class="card card-glass p-0 overflow-hidden">
  <div class="table-responsive devices-table-wrap">
    <table class="table table-dark table-hover align-middle m-0">
      <thead>
        <tr>
          <th>ID</th>
          <th>РќР°Р·РІР°РЅРёРµ</th>
          <th>РЈС‡Р°СЃС‚РѕРє</th>
          <th>РњРµС‚РѕРґ</th>
          <th>URL/IP</th>
          <th class="text-center">РђРєС‚РёРІРµРЅ</th>
          <th class="text-end sticky-actions">Р”РµР№СЃС‚РІРёСЏ</th>
        </tr>
      </thead>
      <tbody>
        <% (devices || []).forEach(d => { %>
          <% const _tableZoneName = (((zones || []).find(z => String(z.id) === String(d.zoneId || d.zone_id || d.zone)) || {}).name) || ''; %>
          <tr data-device-row data-device-search="<%= [d.id, d.name, _tableZoneName].filter(Boolean).join(' ').toLowerCase() %>">
            <td class="text-mono" style="min-width:180px"><%= d.id %></td>
            <td style="min-width:220px">
              <input form="devupd-<%= d.id %>" class="form-control form-control-sm" name="name" value="<%= d.name || '' %>" />
            </td>
            <td style="min-width:220px">
              <select form="devupd-<%= d.id %>" class="form-select form-select-sm" name="zoneId">
                <option value="">вЂ”</option>
                <% (zones || []).forEach(z => { %>
                  <option value="<%= z.id %>" <%= (d.zoneId === z.id) ? 'selected' : '' %>><%= z.name %></option>
                <% }) %>
              </select>
            </td>
            <td style="min-width:120px">
              <select form="devupd-<%= d.id %>" class="form-select form-select-sm" name="method">
                <option value="http" <%= (d.method === 'http') ? 'selected' : '' %>>http</option>
                <option value="rodos" <%= (d.method === 'rodos') ? 'selected' : '' %>>rodos</option>
              </select>
            </td>
            <td style="min-width:260px">
              <input form="devupd-<%= d.id %>" class="form-control form-control-sm" name="url" value="<%= d.url || '' %>" />
            </td>
            <td class="text-center" style="min-width:110px">
              <input
                form="devupd-<%= d.id %>"
                class="form-check-input"
                type="checkbox"
                name="is_active"
                <%= (d.is_active !== false) ? 'checked' : '' %>
              />
            </td>
            <td class="text-end sticky-actions" style="min-width:150px">
              <div class="action-buttons">
                <button class="btn btn-soft btn-sm" type="submit" form="devupd-<%= d.id %>">РћР±РЅРѕРІРёС‚СЊ</button>
                <form method="post" action="/admin/devices/<%= d.id %>/delete" onsubmit="return confirm('РЈРґР°Р»РёС‚СЊ СѓСЃС‚СЂРѕР№СЃС‚РІРѕ?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-sm" type="submit">РЈРґР°Р»РёС‚СЊ</button>
                </form>
              </div>
              <form id="devupd-<%= d.id %>" method="post" action="/admin/devices/<%= d.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"></form>
            </td>
          </tr>
        <% }) %>
        <% if (!devices || !devices.length) { %>
          <tr><td colspan="7" class="text-muted p-3">РџРѕРєР° РЅРёС‡РµРіРѕ РЅРµ РґРѕР±Р°РІР»РµРЅРѕ</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
