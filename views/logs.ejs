  const isSys = <%= user && user.is_is_admin ? 'true' : 'false' %>;
  const effectiveRole = (role === 'admin' && isSys) ? 'sysadmin' : role;

  const hideMap = {
    admin: ['РЈСЃС‚СЂРѕР№СЃС‚РІР°', 'РЈС‡Р°СЃС‚РєРё', 'РђСѓРґРёС‚'],
    dispatcher: ['РџРѕР»СЊР·РѕРІР°С‚РµР»Рё', 'РЈСЃС‚СЂРѕР№СЃС‚РІР°', 'РЈС‡Р°СЃС‚РєРё', 'РђСѓРґРёС‚'],
    user: ['Р–СѓСЂРЅР°Р»', 'РџРѕР»СЊР·РѕРІР°С‚РµР»Рё', 'РЈСЃС‚СЂРѕР№СЃС‚РІР°', 'РЈС‡Р°СЃС‚РєРё', 'РђСѓРґРёС‚']
  };

  (hideMap[effectiveRole] || []).forEach(function(txt){
    document.querySelectorAll('a,button').forEach(function(el){
      if ((el.textContent || '').trim() === txt) {
        const node = el.closest('a,button,li,div');
        if (node) node.style.display = 'none';
      }
    });
  });
});
</script>
