<script>
(function(){
  function maskUrl(v){
    v = String(v || '').trim();
    if (!v) return '';
    try {
      const u = new URL(v);
      if (u.username || u.password) {
        const login = u.username ? (u.username.slice(0,2) + '***') : '';
        return u.protocol + '//' + (login ? login + ':' : '') + '******@' + u.host + (u.pathname || '') + (u.search || '');
      }
      return v;
    } catch(e){
      return v.replace(/\/\/([^:@\/\s]+):([^@\/\s]+)@/g, '//$1:******@');
    }
  }

  // mask URL/IP fields visually but submit original value
  document.querySelectorAll('input[name="url"], input[name="ip"]').forEach(function(inp){
    if (!inp.dataset.realValue) inp.dataset.realValue = inp.value || '';
    const real = inp.dataset.realValue;
    if (real) inp.value = maskUrl(real);

    inp.addEventListener('focus', function(){
      if (inp.dataset.realValue) inp.value = inp.dataset.realValue;
    });
    inp.addEventListener('blur', function(){
      inp.dataset.realValue = inp.value || inp.dataset.realValue || '';
      inp.value = maskUrl(inp.dataset.realValue);
    });
  });

  document.querySelectorAll('form').forEach(function(f){
    f.addEventListener('submit', function(){
      f.querySelectorAll('input[name="url"], input[name="ip"]').forEach(function(inp){
        if (inp.dataset.realValue) inp.value = inp.dataset.realValue;
      });
    });
  });
})();
</script>
<script>
document.addEventListener('DOMContentLoaded', function(){
  function maskUrl(v){
    v = String(v || '').trim();
    if (!v) return '';
    try {
      const u = new URL(v);
      if (u.username || u.password) {
        const login = u.username ? (u.username.slice(0,2) + '***') : '';
        return u.protocol + '//' + (login ? login + ':' : '') + '******@' + u.host + (u.pathname || '') + (u.search || '');
      }
      return v;
    } catch {
      return v.replace(/\/\/([^:@\/\s]+):([^@\/\s]+)@/g, '//$1:******@');
    }
  }

  function ensureSecretFields(form){
    if (!form || form.querySelector('.device-auth-block')) return;
    const urlInput = form.querySelector('input[name="url"], input[name="ip"]');
    if (!urlInput) return;

    const wrap = document.createElement('div');
    wrap.className = 'device-auth-block';
    wrap.style.display = 'grid';
    wrap.style.gridTemplateColumns = '1fr 1fr 1fr';
    wrap.style.gap = '8px';
    wrap.style.marginTop = '8px';

    const auth = document.createElement('select');
    auth.name = 'auth_type';
    auth.className = 'form-control';
    auth.innerHTML = '<option value="none">Р‘РµР· Р°РІС‚РѕСЂРёР·Р°С†РёРё</option><option value="basic">Basic Auth</option>';

    const user = document.createElement('input');
    user.name = 'username';
    user.className = 'form-control';
    user.placeholder = 'Р›РѕРіРёРЅ СѓСЃС‚СЂРѕР№СЃС‚РІР°';

    const pass = document.createElement('input');
    pass.name = 'password';
    pass.type = 'password';
    pass.className = 'form-control';
    pass.placeholder = 'РџР°СЂРѕР»СЊ СѓСЃС‚СЂРѕР№СЃС‚РІР°';

    wrap.appendChild(auth);
    wrap.appendChild(user);
    wrap.appendChild(pass);
    urlInput.parentNode.insertBefore(wrap, urlInput.nextSibling);

    if (!urlInput.dataset.realValue) urlInput.dataset.realValue = urlInput.value || '';
    if (urlInput.dataset.realValue) urlInput.value = maskUrl(urlInput.dataset.realValue);

    urlInput.addEventListener('focus', function(){
      if (urlInput.dataset.realValue) urlInput.value = urlInput.dataset.realValue;
    });
    urlInput.addEventListener('blur', function(){
      urlInput.dataset.realValue = urlInput.value || urlInput.dataset.realValue || '';
      urlInput.value = maskUrl(urlInput.dataset.realValue);
    });
  }

  document.querySelectorAll('form').forEach(ensureSecretFields);

  document.querySelectorAll('form').forEach(function(f){
    f.addEventListener('submit', function(){
      f.querySelectorAll('input[name="url"], input[name="ip"]').forEach(function(inp){
        if (inp.dataset.realValue) inp.value = inp.dataset.realValue;
      });
    });
  });
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function(){
  const searchInput = document.getElementById('devicesSearch');
  const rows = Array.from(document.querySelectorAll('[data-device-row]'));
  if (!searchInput || !rows.length) return;

  function normalize(value) {
    return String(value || '')
      .toLowerCase()
      .replace(/[\u2013\u2014]/g, '-')
      .replace(/С‘/g, 'Рµ')
      .replace(/[^a-zР°-СЏ0-9/#+\-.\s]/gi, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function compact(value) {
    return normalize(value).replace(/\s+/g, '');
  }

  function levenshtein(a, b, maxDistance) {
    const left = String(a || '');
    const right = String(b || '');
    const limit = Number.isFinite(maxDistance) ? maxDistance : Math.max(left.length, right.length);
    if (Math.abs(left.length - right.length) > limit) return limit + 1;
    const prev = Array.from({ length: right.length + 1 }, (_, idx) => idx);
    for (let i = 1; i <= left.length; i += 1) {
      const row = [i];
      let rowMin = row[0];
      for (let j = 1; j <= right.length; j += 1) {
        const cost = left[i - 1] === right[j - 1] ? 0 : 1;
        const next = Math.min(prev[j] + 1, row[j - 1] + 1, prev[j - 1] + cost);
        row[j] = next;
        if (next < rowMin) rowMin = next;
      }
      if (rowMin > limit) return limit + 1;
      for (let j = 0; j < row.length; j += 1) prev[j] = row[j];
    }
    return prev[right.length];
  }

  const SEARCH_ALIAS_GROUPS = [
    {
      label: '-1 СЌС‚Р°Р¶',
      terms: ['-1', '-1 СЌС‚Р°Р¶', 'РјРёРЅСѓСЃ 1', 'РјРёРЅСѓСЃ РїРµСЂРІС‹Р№', 'Рї1', 'РїРѕРґР·РµРјРЅС‹Р№ 1', 'РІСЉРµР·Рґ Рї1'],
      matchTerms: ['-1 СЌС‚Р°Р¶', 'РІСЉРµР·Рґ Рї1', 'Рї1'],
      related: ['РџРѕРґР·РµРјРЅС‹Р№ СѓСЂРѕРІРµРЅСЊ', 'РІСЉРµР·Рґ Рї1']
    },
    {
      label: '-2 СЌС‚Р°Р¶',
      terms: ['-2', '-2 СЌС‚Р°Р¶', 'РјРёРЅСѓСЃ 2', 'РјРёРЅСѓСЃ РІС‚РѕСЂРѕР№', 'Рї2', 'Рї2/3', 'РїРѕРґР·РµРјРЅС‹Р№ 2', 'РІСЉРµР·Рґ Рї2/3'],
      matchTerms: ['-2 СЌС‚Р°Р¶', 'РІСЉРµР·Рґ Рї2/3', 'Рї2', 'Рї2/3'],
      related: ['РџРѕРґР·РµРјРЅС‹Р№ СѓСЂРѕРІРµРЅСЊ', 'РІСЉРµР·Рґ Рї2/3']
    },
    {
      label: 'РџРѕРґР·РµРјРЅС‹Р№ СѓСЂРѕРІРµРЅСЊ',
      terms: ['РїРѕРґР·РµРјРЅС‹Р№', 'РїРѕРґР·РµРјРЅС‹Р№ СѓСЂРѕРІРµРЅСЊ', 'РїРѕРґР·РµРјРєР°', 'РїРѕРґ Р·РµРјР»РµР№', 'РїРѕРґР·РµРјРЅС‹Р№ РІСЉРµР·Рґ'],
      matchTerms: ['РџРѕРґР·РµРјРЅС‹Р№ СѓСЂРѕРІРµРЅСЊ', 'РІСЉРµР·Рґ Рї1', 'РІСЉРµР·Рґ Рї2/3'],
      related: ['РџРѕРґР·РµРјРЅС‹Р№ СѓСЂРѕРІРµРЅСЊ', 'РІСЉРµР·Рґ Рї1', 'РІСЉРµР·Рґ Рї2/3']
    }
  ];

  function aliasGroupScore(query, group) {
    const q = normalize(query);
    const qCompact = compact(q);
    if (!q || !group) return Number.POSITIVE_INFINITY;

    let best = Number.POSITIVE_INFINITY;
    [group.label].concat(group.terms || [], group.matchTerms || [], group.related || []).forEach((term) => {
      const normalized = normalize(term);
      const normalizedCompact = compact(normalized);
      if (!normalized || !normalizedCompact) return;

      if (normalized === q || normalizedCompact === qCompact) {
        best = Math.min(best, 0);
        return;
      }
      if (normalized.startsWith(q) || normalizedCompact.startsWith(qCompact)) {
        best = Math.min(best, 1);
        return;
      }
      if (q.length >= 3 && (normalized.includes(q) || normalizedCompact.includes(qCompact))) {
        best = Math.min(best, 2);
        return;
      }
      const limit = q.length >= 8 ? 2 : 1;
      const distance = levenshtein(qCompact, normalizedCompact, limit);
      if (distance <= limit) {
        best = Math.min(best, 3 + distance);
      }
    });

    return best;
  }

  function looksClose(query, term) {
    const q = normalize(query);
    const t = normalize(term);
    if (!q || !t) return false;
    if (q === t) return true;
    if (q.length >= 4 && (t.includes(q) || q.includes(t))) return true;
    return levenshtein(compact(q), compact(t), q.length >= 8 ? 2 : 1) <= (q.length >= 8 ? 2 : 1);
  }

  function variants(value) {
    const query = normalize(value);
    if (!query) return [];
    const floor = query.match(/^(\d{1,2})(?:\s*(?:СЌС‚|СЌС‚Р°Р¶|СЌС‚Р°Р¶Р°))?$/);
    const set = floor ? new Set() : new Set([query, query.replace(/\s+/g, '')]);
    if (floor) {
      set.add(floor[1] + ' СЌС‚Р°Р¶');
      set.add('СЌС‚Р°Р¶ ' + floor[1]);
      set.add(floor[1] + 'СЌС‚');
      set.add('РІСЉРµР·Рґ ' + floor[1] + 'СЌС‚');
      set.add('РІС‹РµР·Рґ ' + floor[1] + 'СЌС‚');
    }
    SEARCH_ALIAS_GROUPS
      .map((group) => ({ group, score: aliasGroupScore(query, group) }))
      .filter((item) => Number.isFinite(item.score))
      .sort((a, b) => a.score - b.score)
      .slice(0, 1)
      .forEach((item) => {
        (item.group.matchTerms || item.group.related || []).forEach((term) => set.add(normalize(term)));
      });
    return Array.from(set);
  }

  function applySearch() {
    const queryVariants = variants(searchInput.value);
    rows.forEach(function (row) {
      const haystack = normalize(row.getAttribute('data-device-search') || '');
      const haystackCompact = haystack.replace(/\s+/g, '');
      const visible = !queryVariants.length || queryVariants.some(function (item) {
        return haystack.includes(item) || haystackCompact.includes(item.replace(/\s+/g, ''));
      });
      row.classList.toggle('is-search-hidden', !visible);
    });
  }

  searchInput.addEventListener('input', applySearch);
  applySearch();
});
</script>

