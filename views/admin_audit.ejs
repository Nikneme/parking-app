<%- include('partials/header', { title: 'Админ • Аудит изменений', bodyClass, user, path: '/admin/audit' }) %>

<%
  const ACTION_LABELS = {
    login: 'Вход',
    login_failed: 'Неудачный вход',
    login_rate_limited: 'Ограничение входа',
    change_pin: 'Смена пароля',
    logout: 'Выход',
    open: 'Открытие устройства',
    create: 'Создание',
    update: 'Изменение',
    reset_pin: 'Сброс пароля',
    clear_transit_log: 'Очистка журнала транзита',
    delete: 'Удаление',
  };

  const TYPE_LABELS = {
    user: 'Учетная запись',
    users: 'Учетные записи',
    device: 'Устройство',
    devices: 'Устройства',
    zone: 'Участок',
    zones: 'Участки',
    transit_event: 'Событие транзита',
    transit_events: 'Журнал транзита',
    auth: 'Авторизация',
    session: 'Сессия',
    audit: 'Аудит',
    log: 'Журнал',
    logs: 'Журнал событий',
  };

  const ROLE_LABELS = {
    user: 'Арендатор',
    admin: 'Администратор',
    dispatcher: 'Диспетчер',
  };

  const METHOD_LABELS = {
    http: 'HTTP',
    https: 'HTTPS',
    get: 'GET',
    post: 'POST',
    none: 'Без авторизации',
    basic: 'Базовая авторизация',
  };

  const REASON_LABELS = {
    not_found: 'пользователь не найден',
    inactive: 'учетная запись отключена',
    bad_pin: 'неверный пароль',
    first_login_or_reset: 'первый вход или сброс пароля',
    unknown: 'неизвестная причина',
  };

  const SCOPE_LABELS = {
    ip_phone: 'IP + телефон',
    ip: 'IP-адрес',
    phone: 'телефон',
    unknown: 'неизвестно',
  };

  const ZONE_LABELS = {
    'buffer': 'Северный въезд',
    'europlan': 'Этажи 2-9',
    'Elevator doors': 'Лифтовые двери',
    'Above-ground gates': 'Надземные ворота',
    'Above-ground doors': 'Надземные двери',
    'Underground gates': 'Подземные ворота',
    'Underground doors': 'Подземные двери',
    'overground': 'Наземный уровень',
    'pedestrian': 'Входы и лифты',
    'underground': 'Подземный уровень',
    'transit': 'Рампа на эстакаду',
  };

  const boolRu = (v) => (v ? 'да' : 'нет');
  const zoneLabel = (z) => ZONE_LABELS[String(z || '').trim()] || String(z || '');
  const DEVICE_LABELS = {
    lift1: 'Лифт 1',
    p2: 'Въезд П2/3',
  };
  const deviceLabel = (d) => DEVICE_LABELS[String(d || '').trim()] || String(d || '');

  const parseAuditDetails = (d) => {
    if (!d) return null;
    if (typeof d === 'object') return d;
    try { return JSON.parse(d); } catch { return null; }
  };

  const targetDisplay = (e) => {
    const type = String((e && (e.targetType || e.target_type)) || '').trim();
    const id = String((e && (e.targetId || e.target_id)) || '').trim();
    const obj = parseAuditDetails(e && e.details);

    if (type === 'zone' || type === 'zones') {
      return zoneLabel(id) || '—';
    }

    if (type === 'device' || type === 'devices') {
      const gwName =
        (obj && obj.gw && obj.gw.data && Array.isArray(obj.gw.data.results) && obj.gw.data.results[0] && obj.gw.data.results[0].name) ||
        (obj && obj.name) ||
        deviceLabel(id);
      return gwName || id || '—';
    }

    if (type === 'user' || type === 'users') {
      return (obj && obj.fio) || id || '—';
    }

    return id || '—';
  };
  const actionLabel = (a) => ACTION_LABELS[String(a || '').trim()] || String(a || '');
  const typeLabel = (t) => TYPE_LABELS[String(t || '').trim()] || String(t || '');
  const roleLabel = (r) => ROLE_LABELS[String(r || '').trim()] || String(r || '');
  const methodLabel = (m) => METHOD_LABELS[String(m || '').trim().toLowerCase()] || String(m || '');
  const reasonLabel = (r) => REASON_LABELS[String(r || '').trim()] || String(r || '');
  const scopeLabel = (r) => SCOPE_LABELS[String(r || '').trim()] || String(r || '');

  const safeTargetText = (e) => {
    const type = String((e && (e.targetType || e.target_type)) || '').trim();
    const id = String((e && (e.targetId || e.target_id)) || '').trim();

    let details = e && e.details;
    if (typeof details === 'string') {
      try { details = JSON.parse(details); } catch { details = null; }
    }

    if (type === 'zone' || type === 'zones') {
      return zoneLabel(id || (details && (details.zoneId || details.zone)) || '') || '—';
    }

    if (type === 'user' || type === 'users') {
      if (details && details.fio) return details.fio;
      if (id === 'admin') return 'Администратор';
      if (id === 'user') return 'Арендатор';
      if (id === 'dispatcher') return 'Диспетчер';
      return id || 'Учетная запись';
    }

    if (type === 'device' || type === 'devices') {
      const gwName =
        details && details.gw && details.gw.data &&
        Array.isArray(details.gw.data.results) &&
        details.gw.data.results[0] &&
        details.gw.data.results[0].name
          ? details.gw.data.results[0].name
          : '';
      return gwName || id || '—';
    }

    return id || '—';
  };

  const actionClass = (a) => {
    const k = String(a || '').trim();
    if (k === 'open' || k === 'login' || k === 'change_pin') return 'audit-badge-success';
    if (k === 'update' || k === 'reset_pin' || k === 'login_rate_limited') return 'audit-badge-warn';
    if (k === 'delete' || k === 'login_failed') return 'audit-badge-danger';
    return 'audit-badge-info';
  };

  const summarizeDetails = (d) => {
    if (!d) return '—';

    let obj = d;
    if (typeof d === 'string') {
      try {
        obj = JSON.parse(d);
      } catch {
        return String(d)
          .replace(/\busers\b/gi, 'Учетные записи')
          .replace(/\buser\b/gi, 'Учетная запись')
          .replace(/\bdevices\b/gi, 'Устройства')
          .replace(/\bdevice\b/gi, 'Устройство')
          .replace(/\bzones\b/gi, 'Участки')
          .replace(/\bzone\b/gi, 'Участок')
          .replace(/\btransit_event\b/gi, 'Событие транзита')
          .replace(/\btransit_events\b/gi, 'Журнал транзита')
          .replace(/Elevator doors/g, 'Лифтовые двери')
          .replace(/Above-ground gates/g, 'Надземные ворота')
          .replace(/Above-ground doors/g, 'Надземные двери')
          .replace(/Underground gates/g, 'Подземные ворота')
          .replace(/Underground doors/g, 'Подземные двери')
          .replace(/\bbuffer\b/g, 'Северный въезд')
          .replace(/\beuroplan\b/g, 'Этажи 2-9')
          .replace(/\boverground\b/g, 'Наземный уровень')
          .replace(/\bpedestrian\b/g, 'Входы и лифты')
          .replace(/\bunderground\b/g, 'Подземный уровень')
          .replace(/\btransit\b/g, 'Рампа на эстакаду')
          .replace(/Elevator doors/g, 'Лифтовые двери')
          .replace(/Above-ground gates/g, 'Надземные ворота')
          .replace(/Above-ground doors/g, 'Надземные двери')
          .replace(/Underground gates/g, 'Подземные ворота')
          .replace(/Underground doors/g, 'Подземные двери')
          .replace(/\bbuffer\b/g, 'Северный въезд')
          .replace(/\beuroplan\b/g, 'Этажи 2-9')
          .replace(/\boverground\b/g, 'Наземный уровень')
          .replace(/\bpedestrian\b/g, 'Входы и лифты')
          .replace(/\bunderground\b/g, 'Подземный уровень')
          .replace(/\btransit\b/g, 'Рампа на эстакаду')
          .replace(/\badmin\b/g, 'Администратор')
          .replace(/\bdispatcher\b/g, 'Диспетчер')
          .replace(/\bhttp\b/gi, 'HTTP')
          .replace(/\bnone\b/gi, 'Без авторизации')
          .replace(/\bbasic\b/gi, 'Базовая авторизация')
          .slice(0, 160);
      }
    }

    if (typeof obj !== 'object' || obj === null) return String(obj).slice(0, 160);

    const out = [];

    if (obj.fio) out.push('ФИО: ' + obj.fio);
    if (obj.phone) out.push('Телефон: ' + obj.phone);
    if (obj.email) out.push('Email: ' + obj.email);
    if (obj.role) out.push('Роль: ' + roleLabel(obj.role));
    if (obj.reason) out.push('Причина: ' + reasonLabel(obj.reason));
    if (obj.scope) out.push('Лимит: ' + scopeLabel(obj.scope));
    if (obj.retry_after_sec !== undefined) out.push('Повтор через: ' + obj.retry_after_sec + ' сек.');
    if (obj.zoneId) {
      out.push('Участок: ' + zoneLabel(obj.zoneId));
    }
    if (obj.zone) out.push('Участок: ' + zoneLabel(obj.zone));
    if (obj.name) out.push('Название: ' + obj.name);
    if (obj.method) out.push('Метод: ' + methodLabel(obj.method));
    if (obj.url) out.push('Адрес: ' + obj.url);
    if (obj.ip) out.push('IP: ' + obj.ip);
    if (obj.auth_type) out.push('Авторизация: ' + methodLabel(obj.auth_type));
    if (obj.isActive !== undefined) out.push('Активен: ' + boolRu(obj.isActive));
    if (obj.is_active !== undefined) out.push('Активен: ' + boolRu(obj.is_active));
    if (obj.pin_changed) out.push('Пароль изменён');
    if (obj.pin_generated) out.push('Пароль сгенерирован');
    if (obj.pin_set) out.push('Пароль задан вручную');
    if (obj.must_change_pin) out.push('Требуется смена пароля при входе');
    if (obj.pin_expires_at) out.push('Срок действия пароля: ' + obj.pin_expires_at);
    if (obj.http_status) out.push('HTTP статус: ' + obj.http_status);
    if (obj.gw && obj.gw.http_status) out.push('Шлюз: HTTP ' + obj.gw.http_status);

    return out.length ? out.join(' • ') : '—';
  };
%>





<style>
html, body{
  max-width:100%;
  overflow-x:hidden !important;
}

.audit-page{
  width:100%;
  max-width:100%;
  min-width:0;
  overflow-x:hidden;
  padding-bottom:12px;
  background:transparent !important;
  color:var(--text);
}

.audit-head{
  margin-bottom:16px;
}

.audit-filter-card{
  margin:0 auto 16px auto;
  width:100%;
  max-width:700px;
  min-width:0;
  overflow:hidden !important;
  box-sizing:border-box !important;
  background:var(--card) !important;
  border:1px solid var(--border) !important;
  color:var(--text) !important;
  backdrop-filter:blur(10px);
  box-shadow:var(--shadow-card);
}

.audit-filter-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
  align-items:end;
  width:100%;
  max-width:100%;
  min-width:0;
}

.audit-filter-field{
  min-width:0;
  width:100%;
  max-width:100%;
}

.audit-filter-field label{
  display:block;
  margin-bottom:6px;
  color:var(--muted);
}

.audit-filter-field input,
.audit-filter-field .form-control{
  width:100%;
  min-width:0;
  max-width:100%;
  box-sizing:border-box;
  background:var(--field-bg) !important;
  border:1px solid var(--field-border) !important;
  color:var(--text) !important;
}

.audit-filter-actions{
  grid-column:1 / -1;
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:12px;
  width:100%;
  max-width:100%;
  min-width:0;
}

.audit-filter-actions .btn,
.audit-filter-actions a.btn{
  width:100%;
  max-width:100%;
  min-width:0;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  box-sizing:border-box;
}

.audit-table-wrap{
  display:block;
  width:100%;
  max-width:100%;
  min-width:0;
}

.audit-mobile-wrap{
  display:none;
  width:100%;
  max-width:100%;
  min-width:0;
}

.audit-table{
  width:100%;
  table-layout:fixed;
}

.audit-table th,
.audit-table td{
  word-break:break-word;
  overflow-wrap:anywhere;
  white-space:normal;
  vertical-align:top;
}

.audit-col-time{ width:16%; }
.audit-col-who{ width:24%; }
.audit-col-action{ width:18%; }
.audit-col-target{ width:16%; }
.audit-col-details{ width:26%; }

.audit-badge{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:5px 12px;
  border-radius:999px;
  font-size:12px;
  line-height:1.2;
  font-weight:700;
  border:1px solid transparent;
}

.audit-badge-success{
  background:#1f8f57;
  color:#ffffff;
  border-color:#35b874;
}
.audit-badge-warn{
  background:#c98a09;
  color:#111827;
  border-color:#f5c542;
}
.audit-badge-danger{
  background:#b42318;
  color:#ffffff;
  border-color:#ef6b63;
}
.audit-badge-info{
  background:#2457d6;
  color:#ffffff;
  border-color:#6f9bff;
}

.audit-card{
  border-radius:18px;
  padding:14px;
  margin-bottom:12px;
  width:100%;
  max-width:100%;
  min-width:0;
  box-sizing:border-box;
  overflow:hidden;
  background:var(--card) !important;
  border:1px solid var(--border) !important;
  color:var(--text) !important;
  backdrop-filter:blur(10px);
  box-shadow:var(--shadow-card);
}

.audit-card-top{
  display:flex;
  justify-content:space-between;
  gap:10px;
  align-items:flex-start;
  margin-bottom:10px;
}

.audit-card-time{
  font-size:12px;
  color:var(--muted);
}

.audit-card-row{
  margin-bottom:8px;
}

.audit-card-label{
  font-size:12px;
  color:var(--muted);
  margin-bottom:2px;
}

.audit-card-value{
  font-size:14px;
  line-height:1.35;
  word-break:break-word;
  overflow-wrap:anywhere;
  color:var(--text);
}

.audit-table-shell{
  background:var(--card) !important;
  border:1px solid var(--border) !important;
  color:var(--text) !important;
  backdrop-filter:blur(10px);
  box-shadow:var(--shadow-card);
}

.audit-table-shell .table{
  color:var(--text) !important;
  background:transparent !important;
}

.audit-table-shell thead th{
  color:var(--muted) !important;
  border-bottom:1px solid var(--border) !important;
}

.audit-table-shell td{
  border-bottom:1px solid var(--border) !important;
}

.audit-table-shell .text-muted,
.audit-page .text-muted{
  color:var(--muted) !important;
}

.audit-table-shell .fw-semibold,
.audit-page .fw-semibold,
.audit-page strong,
.audit-page h1,
.audit-page h2,
.audit-page h3{
  color:var(--text) !important;
}

@media (max-width: 768px){
  html, body{
    overflow-x:hidden !important;
  }

  .container, .container-fluid, .content, main{
    max-width:100% !important;
    overflow-x:hidden !important;
  }

  .audit-page,
  .audit-head,
  .audit-filter-card,
  .audit-filter-grid,
  .audit-filter-field,
  .audit-filter-actions,
  .audit-mobile-wrap,
  .audit-card{
    width:100% !important;
    max-width:100% !important;
    min-width:0 !important;
    box-sizing:border-box !important;
  }

  .audit-filter-grid{
    grid-template-columns:1fr !important;
    gap:10px !important;
    align-items:stretch !important;
  }

  .audit-filter-field,
  .audit-filter-field input,
  .audit-filter-field .form-control{
    width:100% !important;
    min-width:0 !important;
    max-width:100% !important;
    box-sizing:border-box !important;
  }

  .audit-filter-actions{
    grid-template-columns:1fr !important;
    gap:10px !important;
  }

  .audit-filter-actions .btn,
  .audit-filter-actions a.btn{
    width:100% !important;
    min-width:0 !important;
    max-width:100% !important;
  }

  .audit-table-wrap{
    display:none;
  }

  .audit-mobile-wrap{
    display:block;
  }
}
</style>












