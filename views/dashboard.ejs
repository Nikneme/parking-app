<%- include('partials/header', { title, bodyClass, user, path: '/' }) %>

<%
  // DASHBOARD_DEVICE_NATURAL_SORT_START
  const __dashboardTrailingNum = (d) => {
    const label = String((d && (d.name || d.id)) || '').trim();
    const m = label.match(/(\d+)(?!.*\d)/);
    return m ? Number(m[1]) : Number.POSITIVE_INFINITY;
  };

  const __sortDashboardDevices = (arr) => {
    const list = Array.isArray(arr) ? [...arr] : [];
    list.sort((a, b) => {
      const an = __dashboardTrailingNum(a);
      const bn = __dashboardTrailingNum(b);

      if (an !== bn) return an - bn;

      const aName = String((a && (a.name || a.id)) || '').trim();
      const bName = String((b && (b.name || b.id)) || '').trim();

      const byName = aName.localeCompare(bName, 'ru', {
        numeric: true,
        sensitivity: 'base'
      });
      if (byName !== 0) return byName;

      return String((a && a.id) || '').localeCompare(String((b && b.id) || ''), 'ru', {
        numeric: true,
        sensitivity: 'base'
      });
    });
    return list;
  };

  const __dashText = (value) => String(value || '').trim();
  const __profileArray = (value) => (
    Array.isArray(value)
      ? value.map((item) => __dashText(item)).filter(Boolean)
      : []
  );
  const __pluralRu = (n, one, few, many) => {
    const mod10 = n % 10;
    const mod100 = n % 100;
    if (mod10 === 1 && mod100 !== 11) return one;
    if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) return few;
    return many;
  };

  const __dashboardFloor = (device) => {
    const match = __dashText(device && device.name).match(/(\d+)\s*(?:эт|этаж)/iu);
    return match ? Number(match[1]) : null;
  };

  const __routeMetaForDevice = (device, zoneName) => {
    const name = __dashText(device && device.name).toLowerCase();
    const floor = __dashboardFloor(device);
    if (Number.isFinite(floor)) {
      return {
        key: `floor:${floor}`,
        title: `${floor} этаж`,
        subtitle: 'Прямой проезд на нужный этаж',
        rank: 10 + floor,
        floor,
      };
    }
    if (name.includes('лифт')) {
      return { key: 'lift', title: 'Лифты', subtitle: 'Подъём на нужный этаж', rank: 200, floor: null };
    }
    if (/двер|вход/iu.test(name)) {
      return { key: 'door', title: 'Входы', subtitle: 'Пеший вход с 1 этажа', rank: 210, floor: null };
    }
    if (/въезд|заезд/iu.test(name)) {
      return { key: 'entry', title: 'Въезды', subtitle: 'Заезд к своим местам', rank: 220, floor: null };
    }
    if (name.includes('выезд')) {
      return { key: 'exit', title: 'Выезды', subtitle: 'Выезд с парковки', rank: 230, floor: null };
    }
    if (/шлаг|проезд|рамп/iu.test(name) || /северный въезд|эстакад/iu.test(__dashText(zoneName).toLowerCase())) {
      return { key: 'gate', title: 'Шлагбаумы', subtitle: 'Проезд по маршруту', rank: 240, floor: null };
    }
    return { key: 'other', title: 'Что открыть', subtitle: 'Доступно в этом разделе', rank: 250, floor: null };
  };

  const __routeSectionId = (zoneId, key) => (
    `route-${String(zoneId || '').replace(/[^\w-]/g, '-')}-${String(key || '').replace(/[^\w-]/g, '-')}`
  );

  const __routeSearchText = (parts) => (
    parts
      .filter(Boolean)
      .map((part) => __dashText(part).toLowerCase())
      .join(' ')
  );

  const __buildZoneRoutes = (group) => {
    const zoneId = group && group.zoneId ? group.zoneId : '';
    const zoneName = group && group.zoneName ? group.zoneName : '';
    const devices = __sortDashboardDevices(Array.isArray(group && group.devices) ? group.devices : []);
    const buckets = new Map();

    devices.forEach((device) => {
      const meta = __routeMetaForDevice(device, zoneName);
      const bucket = buckets.get(meta.key) || { ...meta, devices: [] };
      bucket.devices.push(device);
      buckets.set(meta.key, bucket);
    });

    const sections = Array.from(buckets.values())
      .map((section) => {
        const deviceNames = section.devices.map((device) => device && device.name).filter(Boolean);
        const searchText = __routeSearchText([zoneName, section.title, section.subtitle].concat(deviceNames));
        const localSearchText = __routeSearchText([section.title, section.subtitle].concat(deviceNames));
        return {
          ...section,
          id: __routeSectionId(zoneId, section.key),
          devices: __sortDashboardDevices(section.devices),
          count: section.devices.length,
          searchText,
          localSearchText,
          isProfileMatch: __profileMatchesSection({ ...section, searchText }, zoneName),
        };
      })
      .sort((a, b) => {
        const byProfile = Number(b.isProfileMatch) - Number(a.isProfileMatch);
        if (byProfile) return byProfile;
        const af = Number.isFinite(a.floor) ? a.floor : Number.POSITIVE_INFINITY;
        const bf = Number.isFinite(b.floor) ? b.floor : Number.POSITIVE_INFINITY;
        if (af !== bf) return af - bf;
        if (a.rank !== b.rank) return a.rank - b.rank;
        return String(a.title || '').localeCompare(String(b.title || ''), 'ru', {
          numeric: true,
          sensitivity: 'base',
        });
      });

    return { zoneId, zoneName, sections };
  };

  const __safeJson = (value) => JSON.stringify(value || []).replace(/[<>&\u2028\u2029]/g, function (c) {
    return { '<': '\\u003C', '>': '\\u003E', '&': '\\u0026', '\u2028': '\\u2028', '\u2029': '\\u2029' }[c];
  });

  const __stats = (typeof dashboardStats !== 'undefined' && dashboardStats) ? dashboardStats : {};
  const __devicesForJson = Array.isArray(typeof dashboardDevices !== 'undefined' ? dashboardDevices : [])
    ? dashboardDevices
    : [];
  const __recentEvents = Array.isArray(typeof recentEvents !== 'undefined' ? recentEvents : [])
    ? recentEvents
    : [];
  const __zoneSummary = Array.isArray(typeof zoneSummary !== 'undefined' ? zoneSummary : [])
    ? zoneSummary
    : [];
  const __timeline = Array.isArray(typeof dashboardTimeline !== 'undefined' ? dashboardTimeline : [])
    ? dashboardTimeline
    : [];
  const __attentionEvents = Array.isArray(typeof dashboardAttention !== 'undefined' ? dashboardAttention : [])
    ? dashboardAttention
    : [];
  const __supportContact = (typeof supportContact !== 'undefined' && supportContact) ? supportContact : null;
  const __isTenant = !!(user && user.role === 'user');
  const __showOperatorPanels = !!(user && (user.role === 'admin' || user.role === 'dispatcher'));
  const __tenantProfile = {
    parking_floors: __profileArray(user && user.parking_floors),
    parking_groups: __profileArray(user && user.parking_groups),
    parking_spots: __profileArray(user && user.parking_spots),
    preferred_routes: __profileArray(user && user.preferred_routes),
  };
  __tenantProfile.hasProfile = !!(
    __tenantProfile.parking_floors.length ||
    __tenantProfile.parking_groups.length ||
    __tenantProfile.parking_spots.length ||
    __tenantProfile.preferred_routes.length
  );
  const __tenantPrimaryFloor = String(__tenantProfile.parking_floors[0] || '').replace(/[^\d]/g, '');
  const __lastEvent = __stats.lastEvent || __recentEvents[0] || null;
  const __zoneSummaryById = Object.fromEntries(__zoneSummary.map((zone) => [zone.id, zone]));
  const __profileMatchesSection = (section, zoneName) => {
    if (!__isTenant || !__tenantProfile.hasProfile || !section) return false;
    const routeHaystack = __routeSearchText([
      zoneName,
      section.title,
      section.subtitle,
    ]);
    const deviceHaystack = __routeSearchText((Array.isArray(section.devices) ? section.devices.map((device) => device && device.name) : []));
    const haystack = `${routeHaystack} ${deviceHaystack}`.trim();
    const floorMatch = __tenantProfile.parking_floors.some((floor) => {
      const digits = String(floor || '').replace(/[^\d]/g, '');
      return !!digits && (String(section.floor || '') === digits || haystack.includes(digits));
    });
    const routeMatch = __tenantProfile.preferred_routes.some((route) => routeHaystack.includes(String(route || '').toLowerCase()));
    const groupMatch = __tenantProfile.parking_groups.some((group) => haystack.includes(String(group || '').toLowerCase()));
    const spotMatch = __tenantProfile.parking_spots.some((spot) => haystack.includes(String(spot || '').toLowerCase()));
    return floorMatch || routeMatch || groupMatch || spotMatch;
  };
  const __zoneRouteGroups = (Array.isArray(byZone) ? byZone : []).map(__buildZoneRoutes);
  const __zoneRoutesById = Object.fromEntries(__zoneRouteGroups.map((zone) => [zone.zoneId, zone]));
  const __allTenantQuickRoutes = __zoneRouteGroups.flatMap((zone) => (
    zone.sections.map((section) => ({
      ...section,
      zoneId: zone.zoneId,
      zoneName: zone.zoneName,
    }))
  ));
  const __preferredTenantQuickRoutes = __allTenantQuickRoutes.filter((route) => route.isProfileMatch);
  const __tenantQuickRoutes = (__isTenant && __tenantProfile.hasProfile && __preferredTenantQuickRoutes.length)
    ? __preferredTenantQuickRoutes
    : __allTenantQuickRoutes;
  const __tenantQuickRouteMode = (__isTenant && __tenantProfile.hasProfile && __preferredTenantQuickRoutes.length) ? 'profile' : 'fallback';
  const __introTitle = __isTenant ? 'Открыть проезд или вход' : 'Открыть и проверить';
  const __introLead = __isTenant
    ? (__tenantProfile.hasProfile
      ? 'Сначала показано то, что относится к вашему этажу и обычному маршруту.'
      : 'Сначала выберите этаж, вход или нужный проезд. Остальное мы убрали, чтобы не мешало.')
    : 'Найдите нужный въезд, дверь или шлагбаум. Ниже сразу видно, сработала команда или нет.';
  const __recentDeviceActions = __recentEvents
    .map((e) => ({
      id: e.device_id || (e.details && e.details.deviceId) || '',
      name: e.point || '',
      zoneName: e.zone_id || (e.details && e.details.zoneId) || '',
      requestId: e.request_id || '',
      ts: e.datetime_msk || e.datetime || '',
    }))
    .filter((e) => e.id);
  const __clientRecentEvents = __recentEvents.map((e) => ({
    datetime: e.datetime || null,
    datetime_msk: e.datetime_msk || null,
    point: e.point || null,
    event: e.event || null,
    result: e.result || null,
    request_id: e.request_id || null,
    actor_fio: e.actor_fio || null,
    actor_phone: e.actor_phone || null,
    device_id: e.device_id || (e.details && e.details.deviceId) || null,
    zone_id: e.zone_id || (e.details && e.details.zoneId) || null,
    gateway: (e.details && e.details.gateway) || null,
    result_label: e.result_label || null,
  }));
%>


<style>
.dashboard-page{
  width:100%;
  max-width:100%;
}

.ops-panel{
  display:grid;
  gap:14px;
  margin-bottom:14px;
}

.ops-head{
  display:grid;
  grid-template-columns:1fr;
  gap:12px;
}

.ops-title{
  padding:18px 20px;
  border-radius:12px;
  background:linear-gradient(180deg, color-mix(in srgb, var(--accent-soft) 72%, var(--card)), var(--card));
  border:1px solid color-mix(in srgb, var(--accent) 22%, var(--border));
  box-shadow:var(--shadow-card);
}

.ops-kicker{
  display:block;
  margin-bottom:10px;
  font-size:11px;
  line-height:1.1;
  letter-spacing:.08em;
  text-transform:uppercase;
  color:var(--muted);
}

.ops-title h1{
  margin:0;
  font-size:28px;
  line-height:1.15;
}

.ops-lead{
  margin:10px 0 0;
  max-width:56ch;
  color:var(--muted);
  font-size:14px;
  line-height:1.5;
}

.ops-meta{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:12px;
}

.ops-actions{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:14px;
}

.ops-action{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:40px;
  padding:8px 12px;
  border-radius:999px;
  border:1px solid color-mix(in srgb, var(--accent) 20%, var(--field-border));
  background:rgba(255,255,255,.34);
  color:var(--text);
  font-size:13px;
  font-weight:600;
  white-space:nowrap;
  touch-action:manipulation;
  cursor:pointer;
}

.ops-action:hover{
  border-color:var(--ring);
  background:rgba(255,255,255,.46);
}

.ops-pill{
  display:inline-flex;
  align-items:center;
  gap:8px;
  min-height:32px;
  padding:7px 10px;
  border-radius:999px;
  background:rgba(0,0,0,.10);
  border:1px solid color-mix(in srgb, var(--accent) 18%, var(--field-border));
  color:var(--text);
  font-size:12px;
  white-space:nowrap;
}

.ops-dot{
  width:8px;
  height:8px;
  border-radius:999px;
  background:#94a3b8;
  box-shadow:0 0 0 4px rgba(148,163,184,.12);
}

.ops-pill.is-online .ops-dot{
  background:#35b874;
  box-shadow:0 0 0 4px rgba(53,184,116,.14);
}

.ops-pill.is-offline .ops-dot{
  background:#ff6b6b;
  box-shadow:0 0 0 4px rgba(255,107,107,.14);
}

.ops-stats{
  display:none;
}

.ops-stat{
  min-width:0;
  padding:14px;
  border-radius:12px;
  background:var(--card2);
  border:1px solid var(--border);
  box-shadow:var(--shadow-card);
}

.ops-stat-value{
  font-size:26px;
  line-height:1;
  font-weight:800;
}

.ops-stat-label{
  margin-top:6px;
  font-size:12px;
  color:var(--muted);
}

.ops-workbar{
  display:grid;
  grid-template-columns:minmax(260px,1fr) minmax(280px,.9fr);
  gap:12px;
  align-items:start;
}

.ops-search,
.ops-recent{
  padding:16px;
  border-radius:12px;
  background:var(--card2);
  border:1px solid var(--border);
  box-shadow:var(--shadow-card);
}

.dashboard-page.is-searching .ops-recent,
.dashboard-page.is-searching .tenant-action-strip,
.dashboard-page.is-searching .command-center,
.dashboard-page.is-searching .signal-grid{
